---

<footer class="ft w-full relative z-10" translate="no">
	<span class="ft-line" data-ft-line aria-hidden="true"></span>
	<div class="max-w-7xl mx-auto px-6 pt-16 pb-8">
		<div class="ft-grid">
			<div class="ft-brand" data-ft-col>
				<a href="#hero" class="ft-logo sc-focus">
					<img src="/favicon.svg" alt="" width="40" height="41" loading="lazy" />
					<span>SCAL-IA</span>
				</a>
				<p class="ft-tag">Soluciones de inteligencia artificial</p>
				<p class="ft-desc">Desarrollamos soluciones de software a medida potenciadas por Inteligencia Artificial.</p>
				<div class="ft-social">
					{socials.map((s) => (
						<a href={s.href} class="ft-soc sc-focus" aria-label={s.label}>
							<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={s.d}></path></svg>
						</a>
					))}
				</div>
			</div>
			<nav class="ft-col" aria-label="Soluciones" data-ft-col>
				<h3>Soluciones</h3>
				<ul>{solutions.map((l) => <li><a href={l.href} class="sc-focus">{l.label}</a></li>)}</ul>
			</nav>
			<nav class="ft-col" aria-label="Empresa" data-ft-col>
				<h3>Empresa</h3>
				<ul>{company.map((l) => <li><a href={l.href} class="sc-focus">{l.label}</a></li>)}</ul>
			</nav>
			<div class="ft-col ft-contact" data-ft-col>
				<h3>Contacto</h3>
				<a class="ft-mail sc-focus" href="mailto:info@scaliasolutions.site"><span class="material-symbols-outlined" aria-hidden="true">mail</span>info@scaliasolutions.site</a>
				<a class="ft-cta sc-btn sc-btn-ghost" href="#contact"><span class="material-symbols-outlined" aria-hidden="true">rocket_launch</span>Iniciar proyecto</a>
			</div>
		</div>

		<div class="ft-bottom">
			<p class="ft-copy"><span class="material-symbols-outlined" aria-hidden="true">smart_toy</span>© 2026 SCAL-IA by Joseph Vazquez.</p>
			<div class="ft-legal">
				<button type="button" class="sc-focus" data-modal="privacy">Privacidad</button>
				<span aria-hidden="true">·</span>
				<button type="button" class="sc-focus" data-modal="terms">Términos</button>
			</div>
		</div>
	</div>
</footer>

<style>
	.ft { background: linear-gradient(180deg, rgba(1, 3, 10, 0.6), #01030a 40%); }
	.ft-line { position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(23, 203, 218, 0.7), rgba(36, 94, 245, 0.6), transparent); transform-origin: 50% 50%; }
	.ft-grid { display: grid; gap: 2.5rem; grid-template-columns: 1fr 1fr; }
	.ft-brand { grid-column: 1 / -1; }
	.ft-contact { grid-column: 1 / -1; }
	@media (min-width: 640px) { .ft-contact { grid-column: auto; } }
	@media (min-width: 1024px) { .ft-grid { grid-template-columns: 1.6fr 1fr 1fr 1.3fr; } .ft-brand { grid-column: auto; } }
	@media (min-width: 640px) and (max-width: 1023px) { .ft-grid { grid-template-columns: repeat(3, 1fr); } }
	.ft-logo { display: inline-flex; align-items: center; gap: 0.7rem; font-weight: 800; font-size: 1.25rem; letter-spacing: 0.02em; color: #fff; }
	.ft-logo img { width: 40px; height: auto; filter: drop-shadow(0 0 10px rgba(23, 203, 218, 0.5)); }
	.ft-tag { margin-top: 0.8rem; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.26em; text-transform: uppercase; color: #8fd7ff; }
	.ft-desc { margin-top: 0.6rem; max-width: 22rem; font-size: 0.9rem; line-height: 1.6; color: #94a3b8; }
	.ft-social { display: flex; gap: 0.6rem; margin-top: 1.3rem; }
	.ft-soc { width: 2.5rem; height: 2.5rem; display: grid; place-items: center; border-radius: 12px; color: #a8b5c8; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(159, 243, 251, 0.1); transition: color 0.25s, border-color 0.25s, background 0.25s, transform 0.25s; }
	.ft-soc:hover { color: #fff; border-color: rgba(95, 232, 255, 0.5); background: rgba(23, 203, 218, 0.1); transform: translateY(-2px); }
	.ft-col h3 { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #e2e8f0; margin-bottom: 1rem; }
	.ft-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.65rem; }
	.ft-col a { font-size: 0.92rem; color: #a8b5c8; transition: color 0.2s; }
	.ft-col a:hover { color: var(--color-neon-300); }
	.ft-mail { display: inline-flex; align-items: center; gap: 0.5rem; overflow-wrap: anywhere; }
	.ft-mail .material-symbols-outlined { font-size: 1.1rem; color: var(--color-neon-400); }
	.ft-col .ft-cta { display: flex; width: max-content; white-space: nowrap; margin-top: 1.2rem; min-height: 2.6rem; padding: 0 1.1rem; font-size: 0.85rem; color: var(--color-ice); }
	.ft-bottom { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid rgba(159, 243, 251, 0.08); display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; font-size: 0.8rem; color: #8b98ab; }
	.ft-copy { display: inline-flex; align-items: center; gap: 0.5rem; }
	.ft-copy .material-symbols-outlined { font-size: 1rem; color: var(--color-neon-500); }
	.ft-legal { display: flex; align-items: center; gap: 0.8rem; }
	.ft-legal button { color: #a8b5c8; transition: color 0.2s; }
	.ft-legal button:hover { color: var(--color-neon-300); text-decoration: underline; text-underline-offset: 3px; }
	@media (prefers-reduced-motion: reduce) { .ft-soc, .ft-soc:hover { transition: none; transform: none; } }
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { prefersReducedMotion } from '../scripts/fit-mock';

	gsap.registerPlugin(ScrollTrigger);
	if (!prefersReducedMotion()) {
		const tl = gsap.timeline({ scrollTrigger: { trigger: '.ft', start: 'top 92%', once: true } });
		tl.from('[data-ft-line]', { scaleX: 0, duration: 1.1, ease: 'power3.inOut' })
			.from('[data-ft-col]', { autoAlpha: 0, y: 24, duration: 0.6, stagger: 0.1, ease: 'power3.out' }, '-=0.7');
	}
</script>
