---
// Sección "ERP": tablero con módulos, gráficos de ventas e inventario y una factura electrónica,
// con tarjetas de vidrio unidas por líneas a cada módulo.
const features = [
	{ n: 1, icon: 'inventory_2', title: 'Inventario y almacenes', desc: 'Stock en tiempo real por almacén, con kardex y alertas de reposición.', side: 'l' },
	{ n: 2, icon: 'swap_horiz', title: 'Ventas y compras', desc: 'Cotizaciones, pedidos, órdenes de compra y proveedores en un solo flujo.', side: 'l' },
	{ n: 3, icon: 'badge', title: 'RR.HH. y planillas', desc: 'Personal, asistencia y planillas ordenados en un solo lugar.', side: 'l' },
	{ n: 4, icon: 'account_balance', title: 'Contabilidad', desc: 'Asientos generados desde ventas y compras, listos para tu contador.', side: 'r' },
	{ n: 5, icon: 'monitoring', title: 'Reportes en tiempo real', desc: 'Ventas, márgenes e inventario en indicadores para decidir con datos.', side: 'r' },
	{ n: 6, icon: 'receipt_long', title: 'Facturación electrónica SUNAT', desc: 'Facturas, boletas y notas de crédito electrónicas enviadas a SUNAT desde el sistema.', side: 'r' },
];
const modules = [
	{ icon: 'space_dashboard', label: 'Inicio', active: true },
	{ icon: 'inventory_2', label: 'Inventario', t: 1 },
	{ icon: 'point_of_sale', label: 'Ventas', t: 2 },
	{ icon: 'shopping_cart', label: 'Compras' },
	{ icon: 'receipt_long', label: 'Facturación' },
	{ icon: 'account_balance', label: 'Contabilidad' },
	{ icon: 'badge', label: 'RR.HH.', t: 3 },
	{ icon: 'monitoring', label: 'Reportes' },
];
const bars = [42, 55, 48, 63, 58, 71, 66, 80, 74, 86];
---

<section class="erp-section w-full py-24 px-4 relative overflow-x-clip" id="erp" translate="no">
	<div class="max-w-7xl mx-auto relative z-10">
		<div class="text-center mb-14 md:mb-16">
			<div class="sc-eyebrow mb-4">ERP</div>
			<h2 class="text-3xl md:text-5xl font-bold mb-6">
				Toda tu empresa <span class="text-gradient">en un solo sistema</span>
			</h2>
			<p class="text-gray-400 text-lg max-w-2xl mx-auto">
				Inventario, ventas, compras, facturación electrónica, contabilidad y personal conectados, con la información al día.
			</p>
		</div>

		<div class="erp-stage" data-erp-stage>
			<div class="erp-grid">
				<div class="erp-mock-wrap" data-erp-wrap>
					<span class="sc-demo-chip" style="top:-12px;left:16px">Ejemplo</span>
					<div class="erp-mock" data-erp-mock aria-hidden="true">
						<div class="e-dash" data-erp-dash>
							<aside class="e-side">
								<div class="e-brand"><i></i><div><b>Tu empresa</b><span>ERP</span></div></div>
								<ul>
									{modules.map((m) => (
										<li class:list={['e-mod', { 'is-active': m.active }]} data-erp-target={m.t}>
											<span class="material-symbols-outlined">{m.icon}</span>{m.label}
										</li>
									))}
								</ul>
								<div class="e-side-foot"><span class="material-symbols-outlined">settings</span>Configuración</div>
							</aside>
							<div class="e-main">
								<div class="e-top">
									<b>Resumen general</b>
									<span class="e-chip">Este mes</span>
									<span class="e-search"><span class="material-symbols-outlined">search</span>Buscar productos, clientes…</span>
									<span class="e-av">TE</span>
								</div>
								<div class="e-kpis">
									<div class="e-kpi"><span>Ventas del mes</span><b>S/ 84,320</b><em>▲ vs. mes anterior</em></div>
									<div class="e-kpi"><span>Compras</span><b>S/ 37,910</b><em class="n">12 órdenes</em></div>
									<div class="e-kpi"><span>Stock valorizado</span><b>S/ 126,450</b><em class="n">3 almacenes</em></div>
									<div class="e-kpi" data-erp-target="4"><span>Cuentas por cobrar</span><b>S/ 18,760</b><em class="w">5 vencen esta semana</em></div>
								</div>
								<div class="e-row">
									<div class="e-card e-sales" data-erp-target="5">
										<div class="e-card-h"><b>Ventas por semana</b><span>Últimas 10 semanas</span></div>
										<div class="e-bars">
											{bars.map((h) => <i style={`height:${h}%`} data-erp-bar></i>)}
										</div>
									</div>
									<div class="e-card e-inv">
										<div class="e-card-h"><b>Inventario</b><span>Por categoría</span></div>
										<div class="e-inv-body">
											<div class="e-donut" data-erp-donut><span><b>1,248</b>productos</span></div>
											<ul class="e-legend">
												<li><i style="background:#17cbda"></i>Abarrotes</li>
												<li><i style="background:#245ef5"></i>Bebidas</li>
												<li><i style="background:#1fbfae"></i>Limpieza</li>
												<li><i style="background:#6a5cf0"></i>Otros</li>
											</ul>
										</div>
										<div class="e-alert"><span class="material-symbols-outlined">warning</span>3 productos con stock bajo</div>
									</div>
								</div>
								<div class="e-card e-docs">
									<div class="e-card-h"><b>Comprobantes recientes</b><span>Ver todos</span></div>
									<div class="e-doc"><span>F001-000123</span><span>Factura</span><span>S/ 2,360.00</span><em>Aceptado</em></div>
									<div class="e-doc"><span>B001-000245</span><span>Boleta</span><span>S/ 89.90</span><em>Aceptado</em></div>
									<div class="e-doc"><span>F001-000122</span><span>Factura</span><span>S/ 5,782.00</span><em>Aceptado</em></div>
								</div>
							</div>
						</div>

						<!-- Factura electrónica -->
						<div class="e-invoice" data-erp-invoice data-erp-target="6">
							<div class="e-inv-head">
								<div><b>Tu empresa S.A.C.</b><span>RUC 20XXXXXXXXX</span></div>
								<div class="e-inv-box"><span>FACTURA ELECTRÓNICA</span><b>F001-000123</b></div>
							</div>
							<div class="e-inv-client"><span>Cliente</span><b>Cliente S.A.C. · RUC 20XXXXXXXXX</b></div>
							<div class="e-inv-items">
								<div class="e-it h"><span>Descripción</span><span>Cant.</span><span>Importe</span></div>
								<div class="e-it"><span>Producto A</span><span>10</span><span>1,200.00</span></div>
								<div class="e-it"><span>Producto B</span><span>4</span><span>800.00</span></div>
							</div>
							<div class="e-inv-tot">
								<div><span>Op. gravada</span><span>S/ 2,000.00</span></div>
								<div><span>IGV 18%</span><span>S/ 360.00</span></div>
								<div class="t"><span>Total</span><span>S/ 2,360.00</span></div>
							</div>
							<div class="e-inv-foot">
								<div class="e-qr"></div>
								<div class="e-stamp" data-erp-stamp><span class="material-symbols-outlined">verified</span>Aceptada por SUNAT</div>
							</div>
						</div>
					</div>
				</div>

				{features.map((f) => (
					<article class:list={['sc-glass', 'erp-card', `erp-${f.side}`]} data-erp-card={f.n}>
						<span class="erp-num">{f.n}</span>
						<span class="sc-icon-chip material-symbols-outlined" aria-hidden="true">{f.icon}</span>
						<div>
							<h3 class="sc-feature-title">{f.title}</h3>
							<p class="sc-feature-desc">{f.desc}</p>
						</div>
					</article>
				))}
			</div>

			<svg class="erp-lines" aria-hidden="true">
				{features.map((f) => <path class="erp-line" data-erp-line={f.n} d=""></path>)}
			</svg>
			<div class="erp-dots" aria-hidden="true">
				{features.map((f) => <span class="erp-dot" data-erp-dot={f.n}>{f.n}</span>)}
			</div>
		</div>
	</div>
</section>

<style>
	.erp-stage { position: relative; }
	.erp-grid { display: grid; gap: 14px; grid-template-columns: 1fr; }
	.erp-mock-wrap { position: relative; width: 100%; margin-bottom: 18px; }
	@media (min-width: 640px) and (max-width: 1023px) { .erp-grid { grid-template-columns: 1fr 1fr; } .erp-mock-wrap { grid-column: 1 / -1; } }
	@media (min-width: 1024px) {
		.erp-grid {
			grid-template-columns: minmax(190px, 232px) minmax(0, 1fr) minmax(190px, 232px);
			grid-template-rows: repeat(3, auto);
			grid-auto-flow: column;
			column-gap: 48px; row-gap: 16px; align-items: center;
		}
		.erp-mock-wrap { grid-column: 2; grid-row: 1 / span 3; margin: 0; }
		.erp-l { grid-column: 1; } .erp-r { grid-column: 3; }
	}
	.erp-card { display: flex; gap: 12px; padding: 16px 16px 16px 18px; z-index: 3; }
	.erp-num { position: absolute; right: 12px; top: 10px; font-size: 10px; font-weight: 800; color: #5fe8ff; letter-spacing: .1em; }
	.erp-lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 2; }
	.erp-line { fill: none; stroke: #3fd6e6; stroke-width: 1.3; stroke-dasharray: 3 4; opacity: .85; filter: drop-shadow(0 0 4px rgba(23,203,218,.8)); }
	.erp-dots { position: absolute; inset: 0; pointer-events: none; z-index: 4; }
	.erp-dot { position: absolute; left: 0; top: 0; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 99px; display: grid; place-items: center; font-size: 10px; font-weight: 800; color: #031018; background: linear-gradient(135deg, #8ff5ea, #17cbda 50%, #245ef5); box-shadow: 0 0 0 2px rgba(3,8,23,.7), 0 0 14px rgba(23,203,218,.85); }
	@media (max-width: 1023px) { .erp-lines { display: none; } }

	/* ---- Mockup (1000 × 620) ---- */
	.erp-mock { position: absolute; left: 0; top: 0; width: 1000px; height: 620px; transform-origin: 0 0; font: 500 11px/1.35 Inter, system-ui, sans-serif; color: #e8eef7; }
	.erp-mock .material-symbols-outlined { font-size: 15px; font-variation-settings: 'wght' 300; line-height: 1; }
	.e-dash { position: absolute; left: 0; top: 0; width: 830px; height: 580px; display: grid; grid-template-columns: 170px 1fr; border-radius: 14px; overflow: hidden; background: #0a1428; box-shadow: 0 0 0 1px rgba(255,255,255,.08), 0 30px 80px -20px rgba(36,94,245,.45), 0 0 60px -10px rgba(23,203,218,.2); }
	.e-side { display: flex; flex-direction: column; background: #0e1628; border-right: 1px solid #1d2a44; padding: 12px 10px; }
	.e-brand { display: flex; align-items: center; gap: 8px; padding: 2px 6px 14px; border-bottom: 1px solid #1d2a44; margin-bottom: 10px; }
	.e-brand i { width: 28px; height: 28px; border-radius: 8px; background: linear-gradient(135deg, #17cbda, #245ef5); }
	.e-brand b { display: block; font-size: 12px; } .e-brand span { font-size: 9.5px; color: #7f8fae; letter-spacing: .14em; }
	.e-side ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
	.e-mod { display: flex; align-items: center; gap: 9px; height: 31px; padding: 0 10px; border-radius: 8px; color: #a9b6cd; transition: background .4s, color .4s, box-shadow .4s; }
	.e-mod.is-active { background: rgba(23,203,218,.13); color: #9ff3fb; }
	.e-mod.is-lit { color: #dffbff; box-shadow: inset 0 0 0 1px rgba(95,232,255,.6); }
	.e-side-foot { margin-top: auto; display: flex; align-items: center; gap: 9px; padding: 8px 10px; color: #7f8fae; border-top: 1px solid #1d2a44; }
	.e-main { padding: 14px 16px; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
	.e-top { display: flex; align-items: center; gap: 10px; } .e-top > b { font-size: 15px; }
	.e-chip { padding: 4px 10px; border-radius: 99px; background: #16213a; color: #9fb0cc; font-size: 10px; }
	.e-search { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; height: 28px; width: 210px; padding: 0 10px; border-radius: 8px; background: #111c33; color: #7f8fae; font-size: 10px; }
	.e-av { width: 28px; height: 28px; border-radius: 99px; display: grid; place-items: center; background: #1d2a44; font-size: 9px; font-weight: 700; }
	.e-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
	.e-kpi { padding: 10px 12px; border-radius: 11px; background: #0f1a30; border: 1px solid #1c2a47; display: flex; flex-direction: column; gap: 3px; transition: box-shadow .4s; }
	.e-kpi span { font-size: 9.5px; color: #93a3c0; } .e-kpi b { font-size: 16px; } .e-kpi em { font-style: normal; font-size: 9px; color: #4fe3d3; } .e-kpi em.n { color: #93a3c0; } .e-kpi em.w { color: #fcd34d; }
	.e-row { display: grid; grid-template-columns: 1.45fr 1fr; gap: 10px; }
	.e-card { padding: 11px 12px; border-radius: 11px; background: #0f1a30; border: 1px solid #1c2a47; transition: box-shadow .4s; }
	.e-card-h { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; } .e-card-h b { font-size: 11.5px; } .e-card-h span { font-size: 9px; color: #7f8fae; }
	.e-bars { height: 128px; display: flex; align-items: flex-end; gap: 9px; padding: 0 2px; border-bottom: 1px solid #1c2a47; background: repeating-linear-gradient(0deg, transparent 0 31px, rgba(147,163,192,.08) 31px 32px); }
	.e-bars i { flex: 1; border-radius: 5px 5px 2px 2px; background: linear-gradient(180deg, #5fe8ff, #245ef5); transform-origin: bottom; box-shadow: 0 0 12px -2px rgba(23,203,218,.45); }
	.e-bars i:last-child { background: linear-gradient(180deg, #9ff3fb, #17cbda); }
	.e-inv-body { display: flex; align-items: center; gap: 14px; }
	.e-donut { --p: 1; width: 96px; height: 96px; border-radius: 99px; display: grid; place-items: center;
		background: conic-gradient(#17cbda 0 calc(38% * var(--p)), #245ef5 0 calc(66% * var(--p)), #1fbfae 0 calc(86% * var(--p)), #6a5cf0 0 calc(100% * var(--p)), #16213a 0); }
	.e-donut span { width: 66px; height: 66px; border-radius: 99px; background: #0f1a30; display: grid; place-content: center; text-align: center; font-size: 8.5px; color: #93a3c0; }
	.e-donut b { font-size: 14px; color: #fff; }
	.e-legend { list-style: none; margin: 0; padding: 0; display: grid; gap: 5px; font-size: 10px; color: #c7d3e8; } .e-legend i { display: inline-block; width: 8px; height: 8px; border-radius: 3px; margin-right: 6px; }
	.e-alert { margin-top: 10px; display: flex; align-items: center; gap: 6px; padding: 6px 8px; border-radius: 8px; font-size: 9.5px; color: #fcd34d; background: rgba(245,158,11,.1); border: 1px solid rgba(245,158,11,.25); }
	.e-alert .material-symbols-outlined { font-size: 13px; }
	.e-docs { max-width: 470px; }
	.e-doc { display: grid; grid-template-columns: 1fr .8fr 1fr auto; gap: 10px; align-items: center; padding: 6px 0; border-top: 1px solid #1a2742; font-size: 10px; color: #c7d3e8; }
	.e-doc em { font-style: normal; font-size: 9px; padding: 2px 8px; border-radius: 99px; color: #8ff5ea; background: rgba(31,191,174,.15); }
	/* Factura */
	.e-invoice { position: absolute; left: 640px; top: 255px; width: 350px; padding: 16px; border-radius: 14px; color: #0b1222; background: #f6f9ff; box-shadow: 0 30px 60px -20px rgba(0,0,0,.8), 0 0 0 1px rgba(95,232,255,.45), 0 0 40px -6px rgba(23,203,218,.5); font-size: 10px; }
	.e-inv-head { display: flex; justify-content: space-between; gap: 10px; }
	.e-inv-head b { display: block; font-size: 12px; } .e-inv-head span { color: #4b5b7a; font-size: 9.5px; }
	.e-inv-box { text-align: center; border: 1.5px solid #245ef5; border-radius: 8px; padding: 5px 9px; }
	.e-inv-box span { display: block; font-size: 8px; font-weight: 800; letter-spacing: .06em; color: #245ef5; } .e-inv-box b { font-size: 12px; }
	.e-inv-client { margin-top: 10px; padding: 7px 9px; border-radius: 8px; background: #e8eef9; } .e-inv-client span { display: block; font-size: 8.5px; color: #4b5b7a; }
	.e-inv-items { margin-top: 10px; } .e-it { display: grid; grid-template-columns: 1fr 40px 70px; padding: 4px 0; border-bottom: 1px solid #dde4f1; } .e-it span:not(:first-child) { text-align: right; }
	.e-it.h { font-size: 8.5px; font-weight: 700; color: #4b5b7a; text-transform: uppercase; }
	.e-inv-tot { margin-top: 8px; margin-left: auto; width: 170px; display: grid; gap: 3px; } .e-inv-tot div { display: flex; justify-content: space-between; color: #33405a; }
	.e-inv-tot .t { font-weight: 800; font-size: 12px; color: #0b1222; border-top: 1.5px solid #0b1222; padding-top: 4px; }
	.e-inv-foot { margin-top: 10px; display: flex; align-items: center; justify-content: space-between; }
	.e-qr { width: 46px; height: 46px; border-radius: 4px; background:
		conic-gradient(from 90deg at 30% 30%, #0b1222 25%, transparent 0) 0 0 / 11px 11px,
		repeating-linear-gradient(90deg, #0b1222 0 3px, transparent 3px 6px), #fff; opacity: .85; }
	.e-stamp { display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border-radius: 99px; font-weight: 800; font-size: 10.5px; color: #065f56; background: #d2fbf3; border: 1.5px solid #1fbfae; }
	.e-stamp .material-symbols-outlined { font-size: 16px; color: #0f9f8f; font-variation-settings: 'FILL' 1, 'wght' 500; }
	[data-erp-target].is-lit:not(.e-mod) { box-shadow: 0 0 0 1.5px rgba(95,232,255,.85), 0 0 24px rgba(23,203,218,.35); }
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { fitMock, prefersReducedMotion } from '../scripts/fit-mock';
	import { revealCards } from '../scripts/reveal';

	gsap.registerPlugin(ScrollTrigger);
	const root = document.getElementById('erp');
	const stage = root?.querySelector<HTMLElement>('[data-erp-stage]');
	const wrap = root?.querySelector<HTMLElement>('[data-erp-wrap]');
	const mock = root?.querySelector<HTMLElement>('[data-erp-mock]');
	if (root && stage && wrap && mock) {
		const N = 6;
		const get = (a: string, i: number) => root.querySelector<HTMLElement>(`[${a}="${i}"]`)!;
		const cards = Array.from({ length: N }, (_, i) => get('data-erp-card', i + 1));
		const targets = Array.from({ length: N }, (_, i) => get('data-erp-target', i + 1));
		const lines = Array.from({ length: N }, (_, i) => root.querySelector<SVGPathElement>(`[data-erp-line="${i + 1}"]`)!);
		const dots = Array.from({ length: N }, (_, i) => get('data-erp-dot', i + 1));
		const reduce = prefersReducedMotion();
		// Líneas ya dibujadas (con reduced motion: todas desde el inicio).
		const drawn = new Set<number>(reduce ? [0, 1, 2, 3, 4, 5] : []);

		function layout() {
			const sr = stage!.getBoundingClientRect();
			const desktop = window.innerWidth >= 1024;
			for (let i = 0; i < N; i++) {
				const tr = targets[i].getBoundingClientRect();
				const cr = cards[i].getBoundingClientRect();
				const left = i < 3;
				let tx = (desktop ? (left ? tr.left : tr.right) : left ? tr.right : tr.left) - sr.left;
				if (i === 4 && desktop) tx = tr.left + tr.width * 0.92 - sr.left; // gráfico de ventas
				const ty = tr.top + tr.height / 2 - sr.top;
				dots[i].style.transform = `translate(${tx}px, ${ty}px)`;
				if (!desktop) { lines[i].setAttribute('d', ''); continue; }
				const ax = (left ? cr.right : cr.left) - sr.left;
				const ay = cr.top + cr.height / 2 - sr.top;
				const mx = ax + (left ? 22 : -22);
				lines[i].setAttribute('d', `M ${ax} ${ay} H ${mx} L ${tx} ${ty}`);
				const len = lines[i].getTotalLength();
				lines[i].style.strokeDasharray = drawn.has(i) ? '3 4' : `${len}`;
				lines[i].style.strokeDashoffset = drawn.has(i) ? '0' : `${len}`;
				lines[i].dataset.len = String(len);
			}
		}
		fitMock(wrap, mock, 1000, 620, layout);
		window.addEventListener('resize', () => requestAnimationFrame(layout));

		if (!prefersReducedMotion()) {
			const bars = Array.from(root.querySelectorAll<HTMLElement>('[data-erp-bar]'));
			const donut = root.querySelector<HTMLElement>('[data-erp-donut]')!;
			const prox = { p: 0 };
			gsap.set(dots, { autoAlpha: 0, scale: 0.3 });
			donut.style.setProperty('--p', '0');
			const tl = gsap.timeline({ scrollTrigger: { trigger: wrap, start: 'top 85%', once: true } });
			tl.from('[data-erp-dash]', { autoAlpha: 0, y: 40, scale: 0.97, duration: 0.7, ease: 'power3.out' })
				.from(root.querySelectorAll('.e-kpi'), { autoAlpha: 0, y: 12, duration: 0.35, stagger: 0.07 }, '-=0.3')
				.from(bars, { scaleY: 0, duration: 0.6, stagger: 0.05, ease: 'power3.out' }, '-=0.15')
				.to(prox, { p: 1, duration: 0.9, ease: 'power2.out', onUpdate: () => donut.style.setProperty('--p', String(prox.p)) }, '<')
				.from('[data-erp-invoice]', { autoAlpha: 0, x: 60, rotate: 4, duration: 0.6, ease: 'power3.out' }, '-=0.5')
				.from('[data-erp-stamp]', { autoAlpha: 0, scale: 1.8, rotate: -12, duration: 0.4, ease: 'back.out(2.2)' });

		}

		// Tarjetas: cada una aparece al entrar al viewport; después su punto se enciende
		// y la línea guía se dibuja hacia el elemento del panel.
		const isDesk = () => window.innerWidth >= 1024;
		revealCards(cards, {
			from: { x: (_: number, el: HTMLElement) => (isDesk() ? (Number(el.dataset.erpCard) <= 3 ? -24 : 24) : 0) },
			onReveal: (c, delay) => {
				if (reduce) return;
				const i = cards.indexOf(c);
				const t = gsap.timeline({ delay: delay + 0.35 });
				t.to(dots[i], { autoAlpha: 1, scale: 1, duration: 0.25, ease: 'back.out(2.5)' })
					.call(() => { targets[i].classList.add('is-lit'); setTimeout(() => targets[i].classList.remove('is-lit'), 1200); }, [], '<');
				if (isDesk()) t.fromTo(lines[i], { strokeDashoffset: () => Number(lines[i].dataset.len) }, { strokeDashoffset: 0, duration: 0.5, ease: 'power2.inOut', onComplete: () => { drawn.add(i); lines[i].style.strokeDasharray = '3 4'; } }, '<');
				else drawn.add(i);
			},
		});
	}
</script>
