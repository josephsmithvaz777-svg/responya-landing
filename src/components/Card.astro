---
interface Props {
    title: string;
    description: string;
    icon: string;
    color?: "purple" | "cyan" | "pink" | "blue" | "fuchsia" | "indigo";
    delay?: string;
}

const { title, description, icon, color = "cyan", delay = "0s" } = Astro.props;

// Clases específicas por color para que Tailwind las detecte
const colorClasses = {
    purple: {
        card: "neon-purple",
        gradient: "from-nebula-500/5",
        glow: "bg-nebula-500/20",
        shadow: "shadow-nebula-500/5",
        shadowHover: "group-hover:shadow-neon-purple",
        border: "group-hover:border-nebula-500/50",
        iconText: "text-nebula-400",
        titleHover: "group-hover:text-nebula-300",
    },
    cyan: {
        card: "neon-cyan",
        gradient: "from-cyan-500/5",
        glow: "bg-cyan-500/20",
        shadow: "shadow-cyan-500/5",
        shadowHover: "group-hover:shadow-neon-cyan",
        border: "group-hover:border-cyan-500/50",
        iconText: "text-cyan-400",
        titleHover: "group-hover:text-cyan-300",
    },
    pink: {
        card: "neon-pink",
        gradient: "from-aurora-500/5",
        glow: "bg-aurora-500/20",
        shadow: "shadow-aurora-500/5",
        shadowHover: "group-hover:shadow-neon-pink",
        border: "group-hover:border-aurora-500/50",
        iconText: "text-aurora-400",
        titleHover: "group-hover:text-aurora-300",
    },
    blue: {
        card: "neon-blue",
        gradient: "from-blue-500/5",
        glow: "bg-blue-500/20",
        shadow: "shadow-blue-500/5",
        shadowHover: "group-hover:shadow-neon-blue",
        border: "group-hover:border-blue-500/50",
        iconText: "text-blue-400",
        titleHover: "group-hover:text-blue-300",
    },
    fuchsia: {
        card: "neon-fuchsia",
        gradient: "from-neon-500/5",
        glow: "bg-neon-500/20",
        shadow: "shadow-neon-500/5",
        shadowHover: "group-hover:shadow-neon-fuchsia",
        border: "group-hover:border-neon-500/50",
        iconText: "text-neon-400",
        titleHover: "group-hover:text-neon-300",
    },
    indigo: {
        card: "neon-indigo",
        gradient: "from-indigo-500/5",
        glow: "bg-indigo-500/20",
        shadow: "shadow-indigo-500/5",
        shadowHover: "group-hover:shadow-neon-indigo",
        border: "group-hover:border-indigo-500/50",
        iconText: "text-indigo-400",
        titleHover: "group-hover:text-indigo-300",
    },
};

const classes = colorClasses[color];
---

<div
    class={`glass-card ${classes.card} p-8 rounded-2xl flex flex-col items-center text-center relative group overflow-hidden animate-on-scroll`}
    style={`animation-delay: ${delay};`}
>
    <div class="card-shimmer"></div>
    <div class="glow-effect"></div>
    <div
        class={`absolute inset-0 bg-gradient-to-b ${classes.gradient} to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500`}
    >
    </div>
    <div
        class={`absolute -top-10 -right-10 w-40 h-40 ${classes.glow} blur-3xl rounded-full animate-glow-pulse`}
    >
    </div>

    <div
        class={`size-16 rounded-full bg-night-700 border border-white/5 flex items-center justify-center mb-6 shadow-lg ${classes.shadow} ${classes.shadowHover} ${classes.border} transition-all duration-300 group-hover:scale-110 relative z-10 animate-card-float`}
    >
        <span
            class={`material-symbols-outlined ${classes.iconText} text-3xl transition-colors group-hover:rotate-[360deg] duration-700 ease-in-out`}
        >
            {icon}
        </span>
    </div>

    <h3
        class={`text-xl font-bold text-white mb-3 relative z-10 ${classes.titleHover} transition-colors`}
    >
        {title}
    </h3>

    <p
        class="text-gray-400 text-sm leading-relaxed relative z-10 group-hover:text-gray-300 transition-colors"
    >
        {description}
    </p>
</div>

<style>
    .shadow-neon-purple {
        box-shadow: 0 0 20px rgba(90, 60, 230, 0.3);
    }

    .shadow-neon-cyan {
        box-shadow: 0 0 20px rgba(23, 203, 218, 0.3);
    }

    .shadow-neon-pink {
        box-shadow: 0 0 20px rgba(31, 191, 174, 0.3);
    }

    .shadow-neon-blue {
        box-shadow: 0 0 20px rgba(36, 94, 245, 0.3);
    }

    .shadow-neon-fuchsia {
        box-shadow: 0 0 20px rgba(23, 203, 218, 0.3);
    }

    .shadow-neon-indigo {
        box-shadow: 0 0 20px rgba(106, 92, 240, 0.3);
    }
</style>
