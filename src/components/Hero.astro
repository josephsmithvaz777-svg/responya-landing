---
// Hero inspirado en el cuadro final de la intro: logo con brillo y anillos, nebulosa y estrellas con parallax.
// Estrellas generadas en build (semilla fija) como box-shadow: sin imágenes ni canvas.
function stars(n: number, seed: number, colors: string[]) {
	let s = seed;
	const rnd = () => ((s = (s * 16807) % 2147483647) / 2147483647);
	return Array.from({ length: n }, () => `${Math.round(rnd() * 2000)}px ${Math.round(rnd() * 1400)}px ${colors[Math.floor(rnd() * colors.length)]}`).join(',');
}
const layerA = stars(140, 7, ['rgba(255,255,255,.55)', 'rgba(159,243,251,.5)', 'rgba(143,155,255,.45)']);
const layerB = stars(70, 31, ['rgba(255,255,255,.75)', 'rgba(95,232,255,.7)']);
const layerC = stars(26, 97, ['rgba(223,251,255,.95)', 'rgba(95,232,255,.9)']);
const chips = [
	{ href: '#diseno-a-medida', icon: 'design_services', label: 'Diseño a medida' },
	{ href: '#web-ecommerce', icon: 'storefront', label: 'Web y ecommerce' },
	{ href: '#crm', icon: 'forum', label: 'CRM' },
	{ href: '#erp', icon: 'hub', label: 'ERP' },
	{ href: '#services', icon: 'smart_toy', label: 'Soluciones con IA' },
];
---

<section id="hero" class="hero relative w-full overflow-hidden" translate="no">
	<div class="hero-sky" aria-hidden="true">
		<div class="hero-neb" data-hero-neb></div>
		<div class="hero-stars" data-hero-layer="0.15"><i style={`box-shadow:${layerA}`} class="s1"></i></div>
		<div class="hero-stars" data-hero-layer="0.3"><i style={`box-shadow:${layerB}`} class="s2"></i></div>
		<div class="hero-stars" data-hero-layer="0.55"><i style={`box-shadow:${layerC}`} class="s3"></i></div>
	</div>

	<div class="hero-inner" data-hero-inner>
		<div class="hero-logo" data-hero-logo>
			<span class="hero-glow"></span>
			<span class="hero-ring r1"></span>
			<span class="hero-ring r2"></span>
			<img src="/favicon.svg" alt="SCAL-IA" width="112" height="116" fetchpriority="high" />
		</div>

		<div class="hero-tag" data-hero-tag><span class="hero-line"></span>Soluciones de inteligencia artificial<span class="hero-line"></span></div>

		<h1 class="hero-h1">
			<span class="hero-row"><span data-hero-word>Transformamos</span> <span data-hero-word class="text-gradient">ideas</span> <span data-hero-word>en</span></span>
			<span class="hero-row"><span data-hero-word class="text-gradient">innovación</span> <span data-hero-word>con IA</span></span>
		</h1>

		<p class="hero-p" data-hero-fade>
			Desarrollamos soluciones de software a medida potenciadas por Inteligencia Artificial para resolver tus problemas más complejos.
		</p>

		<div class="hero-ctas" data-hero-fade>
			<a class="sc-btn sc-btn-primary" href="#contact"><span class="material-symbols-outlined" aria-hidden="true">rocket_launch</span>Iniciar proyecto</a>
			<a class="sc-btn sc-btn-ghost" href="#crm"><span class="material-symbols-outlined" aria-hidden="true">play_circle</span>Ver demo</a>
		</div>

		<nav class="hero-chips" aria-label="Soluciones" data-hero-fade>
			{chips.map((c) => (
				<a href={c.href} class="hero-chip sc-focus"><span class="material-symbols-outlined" aria-hidden="true">{c.icon}</span>{c.label}</a>
			))}
		</nav>
	</div>

	<a href="#about" class="hero-cue sc-focus" data-hero-cue>
		<span class="hero-mouse" aria-hidden="true"><i></i></span>
		Descubre cómo potenciamos tu negocio
	</a>
</section>

<style>
	.hero { min-height: calc(100svh - 80px); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px 16px 92px; }
	.hero-sky { position: absolute; inset: 0; pointer-events: none; -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent); mask-image: linear-gradient(180deg, #000 70%, transparent); }
	.hero-neb {
		position: absolute; inset: -10% -10% 0;
		background:
			radial-gradient(circle 220px at 50% 26%, rgba(23, 203, 218, 0.26), transparent 70%),
			radial-gradient(ellipse 320px 240px at 40% 22%, rgba(31, 191, 174, 0.16), transparent 70%),
			radial-gradient(ellipse 360px 260px at 62% 34%, rgba(36, 94, 245, 0.2), transparent 70%),
			radial-gradient(ellipse 420px 300px at 16% 62%, rgba(31, 191, 174, 0.12), transparent 70%),
			radial-gradient(ellipse 420px 320px at 86% 56%, rgba(90, 60, 230, 0.18), transparent 70%);
		filter: blur(8px);
	}
	.hero-stars { position: absolute; inset: 0; }
	.hero-stars i { position: absolute; left: 50%; top: 0; margin-left: -1000px; border-radius: 50%; display: block; }
	.hero-stars .s1 { width: 1px; height: 1px; }
	.hero-stars .s2 { width: 1.6px; height: 1.6px; }
	.hero-stars .s3 { width: 2.4px; height: 2.4px; animation: hero-twinkle 4.5s ease-in-out infinite; }
	@keyframes hero-twinkle { 0%, 100% { opacity: 1; } 50% { opacity: 0.45; } }

	.hero-inner { position: relative; z-index: 2; max-width: 60rem; display: flex; flex-direction: column; align-items: center; text-align: center; }
	.hero-logo { position: relative; width: 150px; height: 150px; display: grid; place-items: center; margin-bottom: 14px; }
	.hero-logo img { width: 84px; height: auto; position: relative; z-index: 2; filter: drop-shadow(0 0 18px rgba(23, 203, 218, 0.6)) drop-shadow(0 0 46px rgba(36, 94, 245, 0.45)); }
	.hero-glow { position: absolute; inset: 18px; border-radius: 50%; background: radial-gradient(circle, rgba(23, 203, 218, 0.38), rgba(36, 94, 245, 0.16) 45%, transparent 70%); filter: blur(10px); animation: hero-breathe 5s ease-in-out infinite; }
	.hero-ring { position: absolute; border-radius: 50%; border: 1px solid rgba(95, 232, 255, 0.22); }
	.hero-ring.r1 { inset: 8px; border-top-color: rgba(95, 232, 255, 0.75); animation: hero-spin 14s linear infinite; }
	.hero-ring.r2 { inset: -10px; border-color: rgba(79, 141, 255, 0.14); border-bottom-color: rgba(79, 141, 255, 0.6); animation: hero-spin 22s linear infinite reverse; }
	@keyframes hero-spin { to { transform: rotate(360deg); } }
	@keyframes hero-breathe { 0%, 100% { transform: scale(1); opacity: 0.9; } 50% { transform: scale(1.08); opacity: 1; } }

	.hero-tag { display: inline-flex; align-items: center; gap: 12px; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.32em; text-transform: uppercase; color: #8fd7ff; }
	.hero-line { width: 36px; height: 1px; background: linear-gradient(90deg, transparent, rgba(95, 232, 255, 0.8), transparent); }
	.hero-h1 { margin: 16px 0 16px; font-size: clamp(2.35rem, 1.2rem + 5vw, 4.6rem); line-height: 1.04; font-weight: 800; letter-spacing: -0.035em; }
	.hero-row { display: block; }
	.hero-row > span { display: inline-block; }
	.hero-p { max-width: 40rem; color: rgba(214, 224, 240, 0.86); font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem); line-height: 1.65; }
	.hero-ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 30px; }
	.hero-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 28px; max-width: 46rem; }
	.hero-chip { display: inline-flex; align-items: center; gap: 7px; padding: 7px 14px; border-radius: 999px; font-size: 0.82rem; font-weight: 500; color: #cfe3f5; background: rgba(8, 16, 36, 0.5); border: 1px solid rgba(159, 243, 251, 0.12); transition: color 0.25s, border-color 0.25s, background 0.25s; }
	.hero-chip .material-symbols-outlined { font-size: 1rem; color: var(--color-neon-400); }
	.hero-chip:hover { color: #fff; border-color: rgba(95, 232, 255, 0.45); background: rgba(23, 203, 218, 0.08); }

	.hero-cue { position: absolute; z-index: 2; bottom: 22px; left: 50%; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 10px; font-size: 0.8rem; color: #94a3b8; white-space: nowrap; }
	.hero-cue:hover { color: #e2e8f0; }
	.hero-mouse { width: 20px; height: 30px; border-radius: 12px; border: 1.5px solid rgba(148, 163, 184, 0.6); display: grid; justify-items: center; padding-top: 5px; }
	.hero-mouse i { width: 3px; height: 6px; border-radius: 3px; background: var(--color-neon-400); animation: hero-wheel 1.8s ease-in-out infinite; }
	@keyframes hero-wheel { 0% { transform: translateY(0); opacity: 1; } 70% { transform: translateY(8px); opacity: 0; } 100% { opacity: 0; } }

	@media (max-width: 639px) {
		.hero { padding: 36px 16px 110px; }
		.hero-logo { width: 132px; height: 132px; margin-bottom: 10px; }
		.hero-logo img { width: 74px; }
		.hero-tag { font-size: 0.62rem; letter-spacing: 0.22em; gap: 8px; }
		.hero-line { width: 18px; }
		.hero-ctas { width: 100%; flex-direction: column; align-items: stretch; max-width: 22rem; }
		.hero-chip { font-size: 0.75rem; padding: 6px 11px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-stars .s3, .hero-ring, .hero-glow, .hero-mouse i { animation: none; }
	}
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { prefersReducedMotion } from '../scripts/fit-mock';

	gsap.registerPlugin(ScrollTrigger);
	const hero = document.getElementById('hero');
	// Movimiento reducido: entrada solo con fundidos (sin escalas, giros ni parallax).
	if (hero && prefersReducedMotion()) {
		const q = (s: string) => Array.from(hero.querySelectorAll<HTMLElement>(s));
		gsap.timeline({ defaults: { ease: 'power1.out' } })
			.from('[data-hero-logo]', { autoAlpha: 0, duration: 0.8 })
			.from('[data-hero-tag]', { autoAlpha: 0, duration: 0.5 }, '-=0.4')
			.from(q('[data-hero-word]'), { autoAlpha: 0, duration: 0.5, stagger: 0.06 }, '-=0.2')
			.from(q('[data-hero-fade]'), { autoAlpha: 0, duration: 0.5, stagger: 0.1 }, '-=0.3')
			.from(q('.hero-chip'), { autoAlpha: 0, duration: 0.4, stagger: 0.04 }, '-=0.3')
			.from('[data-hero-cue]', { autoAlpha: 0, duration: 0.5 }, '-=0.2');
	}
	if (hero && !prefersReducedMotion()) {
		const q = (s: string) => Array.from(hero.querySelectorAll<HTMLElement>(s));
		// Entrada (al cargar): el logo "se enciende" como en la intro y luego aparece el texto.
		const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
		tl.from('[data-hero-logo]', { scale: 0.55, autoAlpha: 0, filter: 'blur(14px)', duration: 1.1, ease: 'expo.out' })
			.from('.hero-ring', { scale: 0.6, autoAlpha: 0, duration: 0.9, stagger: 0.12 }, '-=0.8')
			.from('[data-hero-tag]', { autoAlpha: 0, letterSpacing: '0.6em', duration: 0.8 }, '-=0.6')
			.from(q('[data-hero-word]'), { yPercent: 60, autoAlpha: 0, rotateX: -40, transformOrigin: '50% 100%', duration: 0.75, stagger: 0.07 }, '-=0.5')
			.from(q('[data-hero-fade]'), { y: 18, autoAlpha: 0, duration: 0.6, stagger: 0.12 }, '-=0.45')
			.from(q('.hero-chip'), { y: 10, autoAlpha: 0, duration: 0.4, stagger: 0.05 }, '-=0.35')
			.from('[data-hero-cue]', { autoAlpha: 0, duration: 0.6 }, '-=0.2');

		// Parallax al hacer scroll: capas de estrellas a distinta velocidad, nebulosa y contenido.
		const st = { trigger: hero, start: 'top top', end: 'bottom top', scrub: 0.6 };
		q('[data-hero-layer]').forEach((el) => {
			gsap.to(el, { y: () => -window.innerHeight * Number(el.dataset.heroLayer), ease: 'none', scrollTrigger: st });
		});
		gsap.to('[data-hero-neb]', { y: () => window.innerHeight * 0.18, scale: 1.08, ease: 'none', scrollTrigger: st });
		gsap.to('[data-hero-inner]', { y: () => window.innerHeight * 0.16, autoAlpha: 0.15, ease: 'none', scrollTrigger: { ...st, start: 'top+=60 top' } });

		// Parallax sutil con el cursor (solo punteros finos).
		if (window.matchMedia('(pointer: fine)').matches) {
			const layers = q('.hero-stars i');
			const setters = layers.map((el) => ({ x: gsap.quickTo(el, 'x', { duration: 1.2, ease: 'power3' }), y: gsap.quickTo(el, 'y', { duration: 1.2, ease: 'power3' }) }));
			hero.addEventListener('pointermove', (e) => {
				const nx = e.clientX / window.innerWidth - 0.5;
				const ny = e.clientY / window.innerHeight - 0.5;
				setters.forEach((s, i) => { s.x(nx * (i + 1) * -14); s.y(ny * (i + 1) * -10); });
			});
		}
	}
</script>
