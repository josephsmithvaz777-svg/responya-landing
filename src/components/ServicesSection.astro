---
import ServiceMiniUI from './ServiceMiniUI.astro';
// Servicios como bento grid: las 4 soluciones enlazan a su sección; abajo, los servicios existentes.
const solutions = [
	{ href: '#diseno-a-medida', kind: 'dm', icon: 'design_services', eyebrow: 'Diseño a medida', title: 'Software diseñado para tu negocio', desc: 'Del boceto a la aplicación terminada: diseñamos y desarrollamos herramientas que se adaptan a tus procesos, no al revés.' },
	{ href: '#web-ecommerce', kind: 'web', icon: 'storefront', eyebrow: 'Web y ecommerce', title: 'Tu negocio, abierto las 24 horas', desc: 'Páginas web y tiendas online que se ven bien en cualquier pantalla y venden mientras tú atiendes tu negocio.' },
	{ href: '#crm', kind: 'crm', icon: 'forum', eyebrow: 'CRM', title: 'Gestiona tus conversaciones con inteligencia', desc: 'Una bandeja compartida para todo tu equipo, con IA, embudos de venta y automatizaciones.' },
	{ href: '#erp', kind: 'erp', icon: 'hub', eyebrow: 'ERP', title: 'Toda tu empresa en un solo sistema', desc: 'Inventario, ventas, compras, facturación electrónica, contabilidad y personal conectados, con la información al día.' },
];
const services = [
	{ icon: 'smart_toy', title: 'Soluciones con IA', desc: 'Implementamos inteligencia artificial para automatizar decisiones, predecir comportamientos y optimizar procesos.', ai: true },
	{ icon: 'code', title: 'Desarrollo a Medida', desc: 'Creamos aplicaciones y sistemas personalizados que resuelven tus desafíos específicos con las tecnologías más avanzadas.' },
	{ icon: 'settings_heart', title: 'Automatización', desc: 'Eliminamos tareas repetitivas y optimizamos flujos de trabajo con soluciones inteligentes que aumentan la productividad.' },
	{ icon: 'lightbulb', title: 'Consultoría Técnica', desc: 'Asesoramos sobre las mejores estrategias tecnológicas para maximizar resultados y minimizar costos operativos.' },
];
---

<section id="services" class="sv w-full py-24 md:py-28 px-4 relative overflow-x-clip" translate="no">
	<div class="sv-glow" aria-hidden="true"></div>
	<div class="max-w-7xl mx-auto relative z-10">
		<div class="sc-head">
			<div class="sc-eyebrow">Nuestros servicios</div>
			<h2 class="sc-h2">Soluciones <span class="text-gradient">tecnológicas</span> a medida</h2>
			<p class="sc-lead">Creamos tecnología inteligente que transforma tu negocio, automatiza procesos y potencia resultados.</p>
		</div>

		<div class="sv-bento">
			{solutions.map((s) => (
				<a href={s.href} class:list={['sv-tile sc-glass sc-spot sc-focus', `sv-${s.kind}`]} data-sv-tile>
					<div class="sv-art"><ServiceMiniUI kind={s.kind as any} /></div>
					<div class="sv-body">
						<div class="sv-eyebrow"><span class="material-symbols-outlined" aria-hidden="true">{s.icon}</span>{s.eyebrow}</div>
						<h3 class="sv-title">{s.title}</h3>
						<p class="sv-desc">{s.desc}</p>
						<span class="sv-link">Ver sección<span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></span>
					</div>
				</a>
			))}
			{services.map((s) => (
				<article class:list={['sv-card sc-glass sc-spot', { 'sv-ai': s.ai }]} data-sv-tile>
					<span class="sc-icon-chip material-symbols-outlined" aria-hidden="true">{s.icon}</span>
					<h3 class="sv-ctitle">{s.title}</h3>
					<p class="sv-desc">{s.desc}</p>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.sv-glow { position: absolute; left: -10%; top: 30%; width: 600px; height: 600px; border-radius: 50%; background: radial-gradient(circle, rgba(36, 94, 245, 0.12), transparent 65%); pointer-events: none; }
	.sv-bento { display: grid; gap: 1rem; grid-template-columns: 1fr; }
	@media (min-width: 768px) { .sv-bento { grid-template-columns: repeat(2, 1fr); } }
	@media (min-width: 1024px) {
		.sv-bento { grid-template-columns: repeat(12, 1fr); gap: 1.1rem; }
		.sv-dm { grid-column: span 7; } .sv-web { grid-column: span 5; }
		.sv-crm { grid-column: span 5; } .sv-erp { grid-column: span 7; }
		.sv-card { grid-column: span 3; }
	}
	.sv-tile { display: flex; flex-direction: column; border-radius: 22px; overflow: hidden; min-height: 100%; transition: transform 0.35s ease; }
	.sv-tile:hover { transform: translateY(-4px); }
	@media (min-width: 1024px) { .sv-dm, .sv-erp { flex-direction: row; } .sv-dm .sv-art, .sv-erp .sv-art { flex: 0 0 50%; height: auto; min-height: 250px; } .sv-erp { flex-direction: row-reverse; } }
	.sv-art { position: relative; height: 220px; margin: 10px 10px 0; border-radius: 16px; overflow: hidden; background: radial-gradient(ellipse at 30% 20%, rgba(23, 203, 218, 0.16), transparent 60%), linear-gradient(160deg, #0a1730, #071022); border: 1px solid rgba(159, 243, 251, 0.08); }
	@media (min-width: 1024px) { .sv-dm .sv-art, .sv-erp .sv-art { margin: 10px; } .sv-web .sv-art, .sv-crm .sv-art { height: 250px; } }
	.sv-body { padding: 1.3rem 1.5rem 1.5rem; display: flex; flex-direction: column; flex: 1; }
	.sv-eyebrow { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-neon-400); }
	.sv-eyebrow .material-symbols-outlined { font-size: 1.05rem; }
	.sv-title { margin: 0.55rem 0 0.5rem; font-size: 1.3rem; line-height: 1.25; font-weight: 750; color: #fff; letter-spacing: -0.01em; }
	.sv-desc { font-size: 0.93rem; line-height: 1.6; color: rgba(203, 213, 225, 0.85); }
	.sv-link { margin-top: auto; padding-top: 1rem; display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.88rem; font-weight: 600; color: var(--color-neon-300); }
	.sv-link .material-symbols-outlined { font-size: 1.05rem; transition: transform 0.3s ease; }
	.sv-tile:hover .sv-link .material-symbols-outlined { transform: translateX(4px); }
	.sv-card { padding: 1.4rem 1.4rem 1.5rem; border-radius: 20px; }
	.sv-ctitle { margin: 1rem 0 0.45rem; font-size: 1.05rem; font-weight: 700; color: #fff; }
	.sv-ai .sc-icon-chip { background: linear-gradient(135deg, rgba(106, 92, 240, 0.5), rgba(23, 203, 218, 0.35)); }

	@media (prefers-reduced-motion: reduce) { .sv-tile, .sv-tile:hover { transition: none; transform: none; } }
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { prefersReducedMotion } from '../scripts/fit-mock';
	import { initSpotlight } from '../scripts/spotlight';
	import { revealCards } from '../scripts/reveal';
	import { initMiniUIs } from '../scripts/mini-ui';

	gsap.registerPlugin(ScrollTrigger);
	const root = document.getElementById('services');
	if (root) {
		initSpotlight(root);
		// Bento: cada tile aparece al entrar al viewport (en cascada si entran juntos).
		revealCards(root.querySelectorAll<HTMLElement>('[data-sv-tile]'));
		// Mini interfaces realistas en bucle (empiezan al entrar en pantalla, pausa fuera de ella).
		initMiniUIs(root);
	}
</script>
