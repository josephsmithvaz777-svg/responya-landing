	.crm-mock .m-list.is-target { box-shadow: inset 0 0 0 1.5px rgba(95, 227, 238, 0.8), inset 0 0 30px rgba(23, 203, 218, 0.12); }
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const stage = document.getElementById('crm-stage') as HTMLElement | null;
	const wrap = document.getElementById('crm-mock-wrap') as HTMLElement | null;
	const mock = document.getElementById('crm-mock') as HTMLElement | null;

	if (stage && wrap && mock) {
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const N = 6;
		const BASE_W = 1000;
		const BASE_H = 640;
		const revealed = new Set<number>();
		const q = <T extends Element>(sel: string) => stage.querySelector(sel) as T;

		const cards = Array.from({ length: N }, (_, i) => q<HTMLElement>(`[data-card="${i + 1}"]`));
		const paths = Array.from({ length: N }, (_, i) => q<SVGPathElement>(`[data-line="${i + 1}"] path`));
		const ends = Array.from({ length: N }, (_, i) => q<SVGCircleElement>(`[data-line="${i + 1}"] circle`));
		const dots = Array.from({ length: N }, (_, i) => q<HTMLElement>(`[data-dot="${i + 1}"]`));
		const targets = Array.from({ length: N }, (_, i) => mock.querySelector(`[data-crm-target="${i + 1}"]`) as HTMLElement);

		const mode = () => (window.innerWidth >= 1024 ? 'desktop' : window.innerWidth >= 640 ? 'tablet' : 'mobile');

		// Escala el mockup (diseñado a 1000 × 640) al ancho disponible
		function scaleMock() {
			const s = wrap!.clientWidth / BASE_W;
			mock!.style.transform = `scale(${s})`;
			wrap!.style.height = `${BASE_H * s}px`;
		}

		// Calcula posiciones de puntos y líneas
		function layout() {
			scaleMock();
			const sr = stage!.getBoundingClientRect();
			const m = mode();
			for (let i = 0; i < N; i++) {
				const tr = targets[i].getBoundingClientRect();
				const cr = cards[i].getBoundingClientRect();
				// punto objetivo: en el borde del elemento que mira hacia su tarjeta,
				// así el punto no tapa el contenido de la interfaz
				const cardLeft = cr.left + cr.width / 2 < sr.left + sr.width / 2;
				const cardAbove = cr.top + cr.height / 2 < tr.top + tr.height / 2;
				const yFrac = i === 1 ? 0.3 : 0.5;
				let tx = tr.left + tr.width / 2 - sr.left;
				let ty = tr.top + tr.height * yFrac - sr.top;
				if (m === 'desktop') {
					tx = (cardLeft ? tr.left : tr.right) - sr.left;
				} else if (m === 'tablet') {
					ty = (cardAbove ? tr.top : tr.bottom) - sr.top;
					if (i === 1) tx = tr.left + tr.width * 0.5 - sr.left;
				} else {
					tx = tr.left - sr.left;
					if (i === 2 || i === 3 || i === 4) tx = tr.right - sr.left;
				}
				dots[i].style.transform = `translate(${tx}px, ${ty}px)`;

				const p = paths[i];
				let d = '';
				let ax = 0;
				let ay = 0;
				if (m === 'desktop') {
					const leftSide = cr.left + cr.width / 2 < sr.left + sr.width / 2;
					ax = (leftSide ? cr.right : cr.left) - sr.left;
					ay = cr.top + cr.height / 2 - sr.top;
					const kx = ax + (leftSide ? 26 : -26);
					d = `M ${ax} ${ay} H ${kx} L ${tx} ${ty}`;
				} else if (m === 'tablet') {
					const top = cr.top + cr.height / 2 < tr.top + tr.height / 2;
					ax = cr.left + cr.width / 2 - sr.left;
					ay = (top ? cr.bottom : cr.top) - sr.top;
					const ky = ay + (top ? 22 : -22);
					d = `M ${ax} ${ay} V ${ky} L ${tx} ${ty}`;
				}
				p.setAttribute('d', d);
				ends[i].setAttribute('cx', String(ax));
				ends[i].setAttribute('cy', String(ay));
				if (d) {
					const len = p.getTotalLength();
					p.style.strokeDasharray = `${len}`;
					p.style.strokeDashoffset = revealed.has(i) ? '0' : `${len}`;
					p.dataset.len = String(len);
				}
			}
		}

		const typedEls = (i: number) => Array.from(cards[i].querySelectorAll<HTMLElement>('.crm-typed'));

		{
			// Estado inicial
			for (let i = 0; i < N; i++) {
				gsap.set([cards[i], dots[i], ends[i]], { autoAlpha: 0 });
				typedEls(i).forEach((el) => (el.textContent = ''));
			}
			layout();

			const queue: number[] = [];
			let playing = false;
			let current = -1;

			function typeTween(el: HTMLElement, perChar: number) {
				const text = el.dataset.text || '';
				const o = { n: 0 };
				return gsap.to(o, {
					n: text.length,
					duration: Math.max(0.25, text.length * perChar),
					ease: 'none',
					onStart: () => el.classList.add('is-typing'),
					onUpdate: () => {
						el.textContent = text.slice(0, Math.round(o.n));
					},
					onComplete: () => {
						el.textContent = text;
						el.classList.remove('is-typing');
					},
				});
			}

			function step(i: number, fast: boolean) {
				const k = fast ? 0.4 : 1;
				const m = mode();
				const tl = gsap.timeline({ onComplete: run });
				if (current >= 0) {
					targets[current].classList.remove('is-target');
					dots[current].classList.remove('is-live');
				}
				current = i;
				revealed.add(i);
				// 1) la tarjeta aparece (fade + subida + escala + desenfoque)
				// Con movimiento reducido: solo fundido (la línea y el texto escrito se mantienen).
				const from: gsap.TweenVars = reduce ? { autoAlpha: 0 } : { autoAlpha: 0, y: 26, scale: 0.95, filter: 'blur(8px)' };
				if (m === 'desktop' && !reduce) {
					const leftSide = cards[i].getBoundingClientRect().left < window.innerWidth / 2;
					from.x = leftSide ? -14 : 14;
				}
				tl.fromTo(cards[i], from, { autoAlpha: 1, x: 0, y: 0, scale: 1, filter: 'blur(0px)', duration: 0.6 * k, ease: 'power3.out', clearProps: 'filter,transform' });
				// 2) el texto empieza a escribirse en cuanto aparece la tarjeta
				const typeAt = tl.duration() - 0.3 * k;
				// 3) la línea guía se dibuja desde la tarjeta hacia la interfaz y se enciende el punto
				tl.call(() => {
					targets[i].classList.add('is-target');
					dots[i].classList.add('is-live');
				}, [], '-=0.15');
				if (m !== 'mobile') {
					const len = Number(paths[i].dataset.len || 0);
					tl.to(ends[i], { autoAlpha: 1, duration: 0.15 }, '<');
					tl.fromTo(paths[i], { strokeDashoffset: len }, { strokeDashoffset: 0, duration: 0.55 * k, ease: 'power2.inOut' }, '<');
					tl.fromTo(dots[i], { autoAlpha: 0, scale: 0.2 }, { autoAlpha: 1, scale: 1, duration: 0.35 * k, ease: 'back.out(2.5)' }, '-=0.12');
				} else {
					tl.fromTo(dots[i], { scale: 0.6 }, { scale: 1, duration: 0.35 * k, ease: 'back.out(2.5)' }, '<');
				}
				const [title, desc] = typedEls(i);
				const tt = typeTween(title, 0.028 * k);
				tl.add(tt, typeAt);
				tl.add(typeTween(desc, 0.014 * k), typeAt + tt.duration() + 0.05);
				tl.to({}, { duration: 0.15 * k });
				return tl;
			}

			function run() {
				const next = queue.shift();
				if (next === undefined) {
					playing = false;
					return;
				}
				playing = true;
				step(next, queue.length > 0);
			}

			function enqueue(i: number) {
				if (revealed.has(i) || queue.includes(i)) return;
				queue.push(i);
				if (!playing) run();
			}

			const mm = gsap.matchMedia();
			mm.add('(min-width: 640px) and (prefers-reduced-motion: no-preference)', () => {
				// Escenario fijo: se revela una función por tramo de scroll
				const st = ScrollTrigger.create({
					trigger: stage,
					start: 'center center',
					end: () => `+=${N * 260}`,
					pin: true,
					anticipatePin: 1,
					onUpdate: (self) => {
						const upto = Math.min(N, Math.floor(self.progress * (N + 0.5)) + 1);
						for (let i = 0; i < upto; i++) enqueue(i);
					},
					onRefresh: layout,
				});
				return () => st.kill();
			});
			// Móvil, o movimiento reducido en cualquier ancho: sin escenario fijo, una tarjeta por vez al entrar.
			mm.add('(max-width: 639px), (prefers-reduced-motion: reduce)', () => {
				const sts = cards.map((card, i) =>
					ScrollTrigger.create({
						trigger: card,
						start: 'top 85%',
						onEnter: () => {
							for (let j = 0; j <= i; j++) enqueue(j);
						},
					}),
				);
				// Los puntos numerados se ven siempre en móvil
				gsap.set(dots, { autoAlpha: 1 });
				return () => sts.forEach((s) => s.kill());
			});

			let raf = 0;
			window.addEventListener('resize', () => {
				cancelAnimationFrame(raf);
				raf = requestAnimationFrame(layout);
			});
			document.fonts?.ready.then(() => {
				layout();
				ScrollTrigger.refresh();
			});
		}
	}
</script>
