	/* Respeto a prefers-reduced-motion */
	@media (prefers-reduced-motion: reduce) {
		.bubble-glow {
			animation: none;
		}

		.crm-mockup,
		.bubble {
			transition: none;
		}
	}
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	// Check for reduced motion preference
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!prefersReducedMotion) {
		// Animación del mockup (fade in + scale)
		gsap.from('#crm-mockup', {
			scrollTrigger: {
				trigger: '#crm-mockup',
				start: 'top 80%',
				end: 'top 40%',
				toggleActions: 'play none none reverse',
			},
			opacity: 0,
			scale: 0.9,
			duration: 0.8,
			ease: 'power2.out',
		});

		// Animación secuencial de burbujas
		const isMobile = window.innerWidth < 640;
		const bubbles = gsap.utils.toArray('.bubble');

		if (!isMobile) {
			// Desktop/tablet (≥640px): animar burbujas con scroll alrededor del mockup
			bubbles.forEach((bubble, index) => {
				gsap.to(bubble, {
					scrollTrigger: {
						trigger: '.crm-container',
						start: 'top 60%',
						end: 'bottom 20%',
						toggleActions: 'play none none reverse',
					},
					opacity: 1,
					scale: 1,
					duration: 0.6,
					delay: index * 0.15,
					ease: 'back.out(1.7)',
				});
			});
		} else {
			// Mobile (<640px): animar burbujas secuencialmente en el grid
			bubbles.forEach((bubble, index) => {
				gsap.to(bubble, {
					scrollTrigger: {
						trigger: '.crm-bubbles',
						start: 'top 85%',
						toggleActions: 'play none none reverse',
					},
					opacity: 1,
					scale: 1,
					duration: 0.5,
					delay: index * 0.12,
					ease: 'back.out(1.7)',
				});
			});
		}
	} else {
		// Sin animaciones si prefers-reduced-motion
		gsap.set('.bubble', { opacity: 1, scale: 1 });
		gsap.set('#crm-mockup', { opacity: 1, scale: 1 });
	}
</script>
