---
// Sección CRM con mockup de dashboard y burbujas 3D glossy animadas por scroll
---

<section class="crm-section w-full py-24 px-4 relative overflow-hidden" id="crm" translate="no">
	<div class="max-w-7xl mx-auto relative z-10">
		<!-- Header -->
		<div class="text-center mb-16">
			<div
				class="text-cyan-500 text-xs font-bold uppercase tracking-[0.2em] mb-4 flex items-center gap-2 justify-center"
			>
				<span class="w-2 h-2 rounded-full bg-cyan-500 animate-ping-slow"></span>
				CRM para WhatsApp
			</div>
			<h2 class="text-3xl md:text-5xl font-bold mb-6">
				Gestiona tus conversaciones <span class="text-gradient-scalia">con inteligencia</span>
			</h2>
			<p class="text-gray-400 text-lg max-w-2xl mx-auto">
				Un CRM completo diseñado para equipos de ventas que trabajan con WhatsApp
			</p>
		</div>

		<!-- Container principal con mockup y burbujas -->
		<div class="crm-container relative">
			<!-- CRM Dashboard Mockup -->
			<div class="crm-mockup-wrapper" id="crm-mockup">
				<div class="crm-mockup">
					<!-- Browser chrome -->
					<div class="browser-chrome">
						<div class="browser-dots">
							<span></span>
							<span></span>
							<span></span>
						</div>
						<div class="browser-url">app.scaliasolutions.site/crm</div>
					</div>

					<!-- Dashboard content -->
					<div class="dashboard-content">
						<!-- Sidebar -->
						<div class="dashboard-sidebar">
							<div class="sidebar-logo">
								<div class="logo-circle"></div>
								<span>Scalia CRM</span>
							</div>
							<nav class="sidebar-nav">
								<div class="nav-item active">
									<span class="material-symbols-outlined">inbox</span>
									<span>Bandeja</span>
								</div>
								<div class="nav-item">
									<span class="material-symbols-outlined">contacts</span>
									<span>Contactos</span>
								</div>
								<div class="nav-item">
									<span class="material-symbols-outlined">insights</span>
									<span>Pipeline</span>
								</div>
								<div class="nav-item">
									<span class="material-symbols-outlined">bar_chart</span>
									<span>Reportes</span>
								</div>
							</nav>
						</div>

						<!-- Main area -->
						<div class="dashboard-main">
							<!-- Stats cards -->
							<div class="stats-grid">
								<div class="stat-card stat-card-purple">
									<div class="stat-icon">
										<span class="material-symbols-outlined">chat</span>
									</div>
									<div class="stat-content">
										<div class="stat-label">Conversaciones</div>
										<div class="stat-value">324</div>
										<div class="stat-trend positive">+12%</div>
									</div>
								</div>
								<div class="stat-card stat-card-cyan">
									<div class="stat-icon">
										<span class="material-symbols-outlined">trending_up</span>
									</div>
									<div class="stat-content">
										<div class="stat-label">Conversiones</div>
										<div class="stat-value">87</div>
										<div class="stat-trend positive">+8%</div>
									</div>
								</div>
								<div class="stat-card stat-card-pink">
									<div class="stat-icon">
										<span class="material-symbols-outlined">schedule</span>
									</div>
									<div class="stat-content">
										<div class="stat-label">Tiempo respuesta</div>
										<div class="stat-value">2.4m</div>
										<div class="stat-trend negative">-15%</div>
									</div>
								</div>
							</div>

							<!-- Inbox/Pipeline -->
							<div class="inbox-section">
								<div class="inbox-header">
									<h3>Bandeja Compartida</h3>
									<div class="inbox-filters">
										<button class="filter-btn active">Todos</button>
										<button class="filter-btn">Sin asignar</button>
										<button class="filter-btn">Urgentes</button>
									</div>
								</div>
								<div class="inbox-list">
									<div class="inbox-item">
										<div class="contact-avatar">JM</div>
										<div class="contact-info">
											<div class="contact-name">Juan Martínez</div>
											<div class="contact-message">Hola, me interesa el servicio de...</div>
										</div>
										<div class="contact-meta">
											<div class="contact-time">hace 5m</div>
											<div class="contact-status hot">🔥 Caliente</div>
										</div>
									</div>
									<div class="inbox-item">
										<div class="contact-avatar bg-cyan-500">AL</div>
										<div class="contact-info">
											<div class="contact-name">Ana López</div>
											<div class="contact-message">¿Cuándo podemos agendar una llamada?</div>
										</div>
										<div class="contact-meta">
											<div class="contact-time">hace 12m</div>
											<div class="contact-status warm">⚡ Caliente</div>
										</div>
									</div>
									<div class="inbox-item">
										<div class="contact-avatar bg-pink-500">CR</div>
										<div class="contact-info">
											<div class="contact-name">Carlos Rojas</div>
											<div class="contact-message">Gracias por la información</div>
										</div>
										<div class="contact-meta">
											<div class="contact-time">hace 1h</div>
											<div class="contact-status">💬 Activo</div>
										</div>
									</div>
									<div class="inbox-item opacity-60">
										<div class="contact-avatar bg-purple-500">MG</div>
										<div class="contact-info">
											<div class="contact-name">María García</div>
											<div class="contact-message">Perfecto, quedamos así</div>
										</div>
										<div class="contact-meta">
											<div class="contact-time">hace 3h</div>
											<div class="contact-status">✓ Cerrado</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Burbujas 3D Glossy -->
			<div class="crm-bubbles">
				<div class="bubble bubble-1" data-feature="Inteligencia artificial">
					<div class="bubble-inner">
						<div class="bubble-glass"></div>
						<div class="bubble-highlight"></div>
						<div class="bubble-glow"></div>
						<span class="bubble-text">Inteligencia artificial</span>
					</div>
				</div>

				<div class="bubble bubble-2" data-feature="Automatizaciones">
					<div class="bubble-inner">
						<div class="bubble-glass"></div>
						<div class="bubble-highlight"></div>
						<div class="bubble-glow"></div>
						<span class="bubble-text">Automatizaciones</span>
					</div>
				</div>

				<div class="bubble bubble-3" data-feature="Embudo de ventas">
					<div class="bubble-inner">
						<div class="bubble-glass"></div>
						<div class="bubble-highlight"></div>
						<div class="bubble-glow"></div>
						<span class="bubble-text">Embudo de ventas</span>
					</div>
				</div>

				<div class="bubble bubble-4" data-feature="Bandeja compartida">
					<div class="bubble-inner">
						<div class="bubble-glass"></div>
						<div class="bubble-highlight"></div>
						<div class="bubble-glow"></div>
						<span class="bubble-text">Bandeja compartida</span>
					</div>
				</div>

				<div class="bubble bubble-5" data-feature="Reportes en tiempo real">
					<div class="bubble-inner">
						<div class="bubble-glass"></div>
						<div class="bubble-highlight"></div>
						<div class="bubble-glow"></div>
						<span class="bubble-text">Reportes en tiempo real</span>
					</div>
				</div>

				<div class="bubble bubble-6" data-feature="Etiquetado inteligente">
					<div class="bubble-inner">
						<div class="bubble-glass"></div>
						<div class="bubble-highlight"></div>
						<div class="bubble-glow"></div>
						<span class="bubble-text">Etiquetado inteligente</span>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Background effects -->
	<div class="absolute top-1/4 left-0 w-96 h-96 bg-[#245ef5]/10 rounded-full blur-[120px] pointer-events-none"></div>
	<div class="absolute bottom-1/4 right-0 w-96 h-96 bg-[#17cbda]/10 rounded-full blur-[120px] pointer-events-none"></div>
</section>

<style>
	.crm-section {
		min-height: 100vh;
		display: flex;
		align-items: center;
	}

	.crm-container {
		display: grid;
		place-items: center;
		min-height: 600px;
		position: relative;
	}

	/* === CRM Mockup === */
	.crm-mockup-wrapper {
		position: relative;
		width: 100%;
		max-width: 750px;
		margin: 0 auto;
		z-index: 1;
	}

	.crm-mockup {
		background: rgba(10, 10, 22, 0.8);
		border-radius: 16px;
		border: 2px solid rgba(255, 255, 255, 0.1);
		overflow: hidden;
		box-shadow: 
			0 20px 60px rgba(0, 0, 0, 0.5),
			0 0 1px rgba(255, 255, 255, 0.2) inset;
		backdrop-filter: blur(20px);
	}

	.browser-chrome {
		height: 40px;
		background: rgba(20, 20, 35, 0.9);
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		display: flex;
		align-items: center;
		padding: 0 16px;
		gap: 12px;
	}

	.browser-dots {
		display: flex;
		gap: 6px;
	}

	.browser-dots span {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.2);
	}

	.browser-dots span:nth-child(1) { background: #ff5f56; }
	.browser-dots span:nth-child(2) { background: #ffbd2e; }
	.browser-dots span:nth-child(3) { background: #27c93f; }

	.browser-url {
		flex: 1;
		background: rgba(0, 0, 0, 0.3);
		border-radius: 6px;
		padding: 6px 12px;
		font-size: 11px;
		color: rgba(255, 255, 255, 0.5);
		font-family: 'SF Mono', 'Monaco', monospace;
	}

	.dashboard-content {
		display: flex;
		height: 500px;
		background: rgba(5, 5, 17, 0.95);
	}

	.dashboard-sidebar {
		width: 200px;
		background: rgba(10, 10, 22, 0.8);
		border-right: 1px solid rgba(255, 255, 255, 0.05);
		padding: 20px 12px;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.sidebar-logo {
		display: flex;
		align-items: center;
		gap: 10px;
		font-weight: 600;
		font-size: 14px;
		color: white;
	}

	.logo-circle {
		width: 28px;
		height: 28px;
		border-radius: 8px;
		background: linear-gradient(135deg, #17cbda, #245ef5);
	}

	.sidebar-nav {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.nav-item {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 12px;
		border-radius: 8px;
		font-size: 13px;
		color: rgba(255, 255, 255, 0.6);
		cursor: pointer;
		transition: all 0.2s;
	}

	.nav-item:hover {
		background: rgba(255, 255, 255, 0.05);
		color: white;
	}

	.nav-item.active {
		background: rgba(23, 203, 218, 0.2);
		color: #17cbda;
	}

	.nav-item .material-symbols-outlined {
		font-size: 18px;
	}

	.dashboard-main {
		flex: 1;
		padding: 24px;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
	}

	.stat-card {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		padding: 16px;
		display: flex;
		gap: 12px;
		align-items: flex-start;
	}

	.stat-icon {
		width: 40px;
		height: 40px;
		border-radius: 10px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 20px;
	}

	.stat-card-purple .stat-icon {
		background: rgba(23, 203, 218, 0.2);
		color: #17cbda;
	}

	.stat-card-cyan .stat-icon {
		background: rgba(36, 94, 245, 0.2);
		color: #245ef5;
	}

	.stat-card-pink .stat-icon {
		background: rgba(23, 203, 218, 0.15);
		color: #17cbda;
	}

	.stat-content {
		flex: 1;
	}

	.stat-label {
		font-size: 11px;
		color: rgba(255, 255, 255, 0.5);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 4px;
	}

	.stat-value {
		font-size: 24px;
		font-weight: 700;
		color: white;
		line-height: 1;
		margin-bottom: 4px;
	}

	.stat-trend {
		font-size: 11px;
		font-weight: 600;
	}

	.stat-trend.positive {
		color: #27c93f;
	}

	.stat-trend.negative {
		color: #ff5f56;
	}

	.inbox-section {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.05);
		border-radius: 12px;
		overflow: hidden;
	}

	.inbox-header {
		padding: 16px 20px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.inbox-header h3 {
		font-size: 14px;
		font-weight: 600;
		color: white;
	}

	.inbox-filters {
		display: flex;
		gap: 6px;
	}

	.filter-btn {
		padding: 6px 12px;
		font-size: 11px;
		border-radius: 6px;
		background: rgba(255, 255, 255, 0.05);
		color: rgba(255, 255, 255, 0.6);
		border: none;
		cursor: pointer;
		transition: all 0.2s;
	}

	.filter-btn:hover {
		background: rgba(255, 255, 255, 0.1);
		color: white;
	}

	.filter-btn.active {
		background: rgba(23, 203, 218, 0.3);
		color: #17cbda;
	}

	.inbox-list {
		display: flex;
		flex-direction: column;
	}

	.inbox-item {
		display: flex;
		gap: 12px;
		padding: 14px 20px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.03);
		align-items: center;
		transition: background 0.2s;
		cursor: pointer;
	}

	.inbox-item:hover {
		background: rgba(255, 255, 255, 0.03);
	}

	.contact-avatar {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: linear-gradient(135deg, #17cbda, #245ef5);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 13px;
		font-weight: 600;
		color: white;
		flex-shrink: 0;
	}

	.contact-info {
		flex: 1;
		min-width: 0;
	}

	.contact-name {
		font-size: 13px;
		font-weight: 600;
		color: white;
		margin-bottom: 2px;
	}

	.contact-message {
		font-size: 12px;
		color: rgba(255, 255, 255, 0.5);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.contact-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 4px;
	}

	.contact-time {
		font-size: 11px;
		color: rgba(255, 255, 255, 0.4);
	}

	.contact-status {
		font-size: 10px;
		padding: 3px 8px;
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.05);
		color: rgba(255, 255, 255, 0.7);
		white-space: nowrap;
	}

	.contact-status.hot {
		background: rgba(255, 95, 86, 0.2);
		color: #ff5f56;
	}

	.contact-status.warm {
		background: rgba(255, 189, 46, 0.2);
		color: #ffbd2e;
	}

	/* === Burbujas 3D Glossy === */
	.crm-bubbles {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 10;
	}

	.bubble {
		position: absolute;
		opacity: 0;
		transform: scale(0.5);
		pointer-events: none;
		z-index: 10;
	}

	.bubble-inner {
		position: relative;
		width: 160px;
		height: 160px;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 20px;
	}

	/* Cristal base con gradiente iridiscente */
	.bubble-glass {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: 
			radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.4), transparent 50%),
			radial-gradient(circle at 70% 70%, rgba(36, 94, 245, 0.3), transparent 50%),
			linear-gradient(135deg, 
				rgba(23, 203, 218, 0.3), 
				rgba(36, 94, 245, 0.25), 
				rgba(23, 203, 218, 0.2)
			);
		backdrop-filter: blur(20px);
		border: 2px solid rgba(255, 255, 255, 0.2);
		box-shadow: 
			inset 0 0 30px rgba(255, 255, 255, 0.1),
			0 8px 32px rgba(0, 0, 0, 0.3);
	}

	/* Highlight especular (brillo superior) */
	.bubble-highlight {
		position: absolute;
		top: 10%;
		left: 15%;
		width: 45%;
		height: 45%;
		border-radius: 50%;
		background: radial-gradient(circle at 30% 30%, 
			rgba(255, 255, 255, 0.8), 
			rgba(255, 255, 255, 0.3) 40%, 
			transparent 70%
		);
		filter: blur(8px);
		transform: rotate(-15deg);
	}

	/* Glow exterior */
	.bubble-glow {
		position: absolute;
		inset: -20px;
		border-radius: 50%;
		background: radial-gradient(circle, 
			rgba(23, 203, 218, 0.5), 
			rgba(36, 94, 245, 0.4) 40%, 
			transparent 70%
		);
		filter: blur(20px);
		opacity: 0.6;
		animation: glow-pulse 3s ease-in-out infinite;
	}

	@keyframes glow-pulse {
		0%, 100% { opacity: 0.4; transform: scale(1); }
		50% { opacity: 0.8; transform: scale(1.05); }
	}

	.bubble-text {
		position: relative;
		z-index: 10;
		color: white;
		font-size: 13px;
		font-weight: 600;
		text-align: center;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
		line-height: 1.3;
		max-width: 120px;
	}

	/* Posicionamiento desktop de burbujas - ajustado para mockup más pequeño */
	.bubble-1 { top: 8%; left: 5%; }
	.bubble-2 { top: 8%; right: 5%; }
	.bubble-3 { top: 45%; left: 0%; }
	.bubble-4 { top: 45%; right: 0%; }
	.bubble-5 { bottom: 8%; left: 8%; }
	.bubble-6 { bottom: 8%; right: 8%; }

	/* === Responsive === */
	@media (max-width: 1024px) {
		.dashboard-content {
			height: 450px;
		}

		.dashboard-sidebar {
			width: 160px;
			padding: 16px 8px;
		}

		.sidebar-logo {
			font-size: 12px;
		}

		.logo-circle {
			width: 24px;
			height: 24px;
		}

		.nav-item {
			font-size: 12px;
			padding: 8px 10px;
		}

		.nav-item .material-symbols-outlined {
			font-size: 16px;
		}

		.dashboard-main {
			padding: 16px;
		}

		.stats-grid {
			gap: 12px;
		}

		.stat-card {
			padding: 12px;
		}

		.stat-icon {
			width: 32px;
			height: 32px;
			font-size: 16px;
		}

		.stat-value {
			font-size: 20px;
		}

		.inbox-item {
			padding: 12px 16px;
		}

		.contact-avatar {
			width: 36px;
			height: 36px;
			font-size: 12px;
		}

		/* Burbujas más pequeñas en tablet */
		.bubble-inner {
			width: 120px;
			height: 120px;
		}

		.bubble-text {
			font-size: 11px;
			max-width: 90px;
		}

		/* Reposicionar burbujas en tablet - siguen flotando */
		.bubble-1 { top: 5%; left: 3%; }
		.bubble-2 { top: 10%; right: 3%; }
		.bubble-3 { top: 45%; left: -1%; }
		.bubble-4 { top: 45%; right: -1%; }
		.bubble-5 { bottom: 10%; left: 5%; }
		.bubble-6 { bottom: 8%; right: 5%; }
	}

	@media (max-width: 640px) {
		.crm-section {
			padding: 60px 12px;
		}

		.crm-container {
			min-height: auto;
			padding: 0 4px;
		}

		.crm-mockup-wrapper {
			max-width: 100%;
			padding: 0 4px;
		}

		.crm-mockup {
			border-radius: 12px;
		}

		.dashboard-content {
			flex-direction: column;
			height: auto;
		}

		.dashboard-sidebar {
			width: 100%;
			flex-direction: row;
			justify-content: space-around;
			border-right: none;
			border-bottom: 1px solid rgba(255, 255, 255, 0.05);
			padding: 12px;
		}

		.sidebar-logo {
			display: none;
		}

		.sidebar-nav {
			flex-direction: row;
			gap: 2px;
			width: 100%;
