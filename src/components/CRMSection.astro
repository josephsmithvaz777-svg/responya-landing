---
// Sección CRM: recreación en HTML/CSS de la bandeja de WACRM (el CRM de WhatsApp de Scalia)
// con tarjetas de vidrio y líneas de señalización que se revelan una a una al hacer scroll.

const features = [
	{
		n: 1,
		icon: 'auto_awesome',
		title: 'Inteligencia artificial',
		desc: 'Redacta respuestas y contesta sola con tu base de conocimiento.',
		pos: 'p-l3 p-b2',
	},
	{
		n: 2,
		icon: 'forum',
		title: 'Bandeja compartida',
		desc: 'Todo tu equipo atiende un mismo número de WhatsApp.',
		pos: 'p-l1 p-t1',
	},
	{
		n: 3,
		icon: 'assignment_ind',
		title: 'Asignación por agente',
		desc: 'Cada chat con su responsable, estado y notas internas.',
		pos: 'p-r1 p-t2',
	},
	{
		n: 4,
		icon: 'sell',
		title: 'Etiquetas y contactos',
		desc: 'Segmenta clientes con etiquetas y campos personalizados.',
		pos: 'p-r2 p-t3',
	},
	{
		n: 5,
		icon: 'view_kanban',
		title: 'Embudos de venta',
		desc: 'Deals ligados a cada conversación, de nuevo lead a ganado.',
		pos: 'p-r3 p-b3',
	},
	{
		n: 6,
		icon: 'bolt',
		title: 'Automatizaciones',
		desc: 'Flujos sin código por palabra clave, horario o contacto nuevo.',
		pos: 'p-l2 p-b1',
	},
];

const nav = [
	{ icon: 'space_dashboard', label: 'Panel' },
	{ icon: 'chat', label: 'Bandeja', active: true },
	{ icon: 'group', label: 'Contactos' },
	{ icon: 'checklist', label: 'Tareas' },
	{ icon: 'account_tree', label: 'Embudos' },
	{ icon: 'calculate', label: 'Cotizador' },
	{ icon: 'campaign', label: 'Difusiones' },
	{ icon: 'bolt', label: 'Automatizaciones', target: 6 },
	{ icon: 'schema', label: 'Flujos', beta: true },
	{ icon: 'smart_toy', label: 'Agentes IA' },
];

const convs = [
	{ i: 'MF', name: 'María Fernández', msg: 'Sí, por favor. Somos 3 sucursales.', time: '2 min', unread: 2, tag: '#f59e0b', active: true, c: 'linear-gradient(135deg,#17cbda,#245ef5)' },
	{ i: 'CQ', name: 'Carlos Quispe', msg: 'Perfecto, envíame la cotización', time: '14 min', unread: 1, tag: '#22c55e', c: '#7c5cff' },
	{ i: 'LT', name: 'Lucía Torres', msg: 'Gracias, quedo atenta 🙌', time: '1 h', tag: '#17cbda', c: '#e0527a' },
	{ i: 'IS', name: 'Inmobiliaria Sur', msg: 'Diego: ¿Cuándo es la visita?', time: '3 h', group: true, c: '#0ea5a4' },
	{ i: 'DR', name: 'Diego Ramos', msg: '¿Atienden los sábados?', time: 'Ayer', tag: '#a78bfa', c: '#d97706' },
	{ i: 'PA', name: 'Paola Arias', msg: 'Listo, ya hice el pago ✅', time: 'Ayer', c: '#2563eb' },
];
---

<section class="crm-section w-full py-24 px-4 relative overflow-hidden" id="crm" translate="no">
	<div class="max-w-7xl mx-auto relative z-10">
		<div class="text-center mb-14 md:mb-16">
			<div class="text-cyan-500 text-xs font-bold uppercase tracking-[0.2em] mb-4 flex items-center gap-2 justify-center">
				<span class="w-2 h-2 rounded-full bg-cyan-500 animate-ping-slow"></span>
				CRM para WhatsApp
			</div>
			<h2 class="text-3xl md:text-5xl font-bold mb-6">
				Gestiona tus conversaciones <span class="text-gradient-scalia">con inteligencia</span>
			</h2>
			<p class="text-gray-400 text-lg max-w-2xl mx-auto">
				Una bandeja compartida para todo tu equipo, con IA, embudos de venta y automatizaciones.
			</p>
		</div>

		<div class="crm-stage" id="crm-stage">
			<div class="crm-grid">
				<!-- Mockup de WACRM -->
				<div class="crm-mock-wrap" id="crm-mock-wrap">
					<div class="crm-mock" id="crm-mock" aria-hidden="true">
						<div class="m-chrome">
							<div class="m-dots"><span></span><span></span><span></span></div>
							<div class="m-url"><span class="material-symbols-outlined">lock</span>app.scaliasolutions.site/inbox</div>
						</div>
						<div class="m-app">
							<!-- Sidebar -->
							<aside class="m-side">
								<div class="m-brand">
									<div class="m-logo"><span class="material-symbols-outlined">chat</span></div>
									<span>Scalia CRM</span>
								</div>
								<ul class="m-nav">
									{nav.map((item) => (
										<li class:list={['m-nav-item', { 'is-active': item.active }]} data-crm-target={item.target}>
											<span class="material-symbols-outlined">{item.icon}</span>
											<span class="m-nav-label">{item.label}</span>
											{item.beta && <span class="m-beta">Beta</span>}
										</li>
									))}
								</ul>
								<div class="m-sep"></div>
								<div class="m-nav-item"><span class="material-symbols-outlined">settings</span><span class="m-nav-label">Configuración</span></div>
								<div class="m-user">
									<div class="m-av" style="background:#334155">AS</div>
									<div>
										<div class="m-user-name">Andrea Salas</div>
										<div class="m-user-mail">ventas@scalia.pe</div>
									</div>
								</div>
							</aside>

							<!-- Lista de conversaciones -->
							<div class="m-list" data-crm-target="2">
								<div class="m-search"><span class="material-symbols-outlined">search</span>Buscar conversaciones…</div>
								<div class="m-filters">
									<span class="is-on">Todas</span><span>No leídas <b>3</b></span><span>Abiertas</span><span>Pendientes</span>
								</div>
								<div class="m-convs">
									{convs.map((c) => (
										<div class:list={['m-conv', { 'is-active': c.active }]}>
											<div class="m-av" style={`background:${c.c}`}>{c.i}</div>
											<div class="m-conv-body">
												<div class="m-conv-top">
													<span class="m-conv-name">{c.name}</span>
													<span class="m-conv-time">{c.time}</span>
												</div>
												<div class="m-conv-bottom">
													<span class="m-conv-msg">{c.msg}</span>
													{c.unread && <span class="m-badge">{c.unread}</span>}
												</div>
												<div class="m-conv-tags">
													{c.tag && <span class="m-tdot" style={`background:${c.tag}`}></span>}
													{c.group && <span class="m-chip-xs">Grupo</span>}
												</div>
											</div>
										</div>
									))}
								</div>
							</div>

							<!-- Conversación -->
							<div class="m-thread">
								<div class="m-thread-head">
									<div class="m-av" style="background:linear-gradient(135deg,#17cbda,#245ef5)">MF</div>
									<div class="m-th-info">
										<div class="m-th-name">María Fernández</div>
										<div class="m-th-phone">+51 987 654 321 · <span class="m-timer">23 h restantes</span></div>
									</div>
									<div class="m-th-actions">
										<span class="m-status"><i></i>Abierta</span>
										<span class="m-assign" data-crm-target="3"><span class="m-av m-av-xs" style="background:#e0527a">LT</span>Lucía T.<span class="material-symbols-outlined">expand_more</span></span>
									</div>
								</div>
								<div class="m-ai-banner">
									<span class="material-symbols-outlined">smart_toy</span>
									<span>El asistente IA está respondiendo automáticamente</span>
									<span class="m-ai-btn">Tomar control</span>
								</div>
								<div class="m-msgs">
									<div class="m-day">Hoy</div>
									<div class="m-msg in">Hola, vi su anuncio en Instagram. ¿Tienen planes para restaurantes?<span class="m-meta">10:42</span></div>
									<div class="m-msg out" data-crm-target="1">
										<span class="m-ai-chip"><span class="material-symbols-outlined">auto_awesome</span>IA</span>
										¡Hola María! Sí, el plan Negocio incluye bandeja compartida y respuestas automáticas desde S/ 149 al mes. ¿Te envío la cotización?
										<span class="m-meta">10:42 <span class="material-symbols-outlined">done_all</span></span>
									</div>
									<div class="m-msg in">Sí, por favor. Somos 3 sucursales.<span class="m-meta">10:44</span></div>
								</div>
								<div class="m-composer">
									<span class="material-symbols-outlined m-c-ico">add</span>
									<span class="m-input">Escribe un mensaje…</span>
									<span class="m-spark"><span class="material-symbols-outlined">auto_awesome</span></span>
									<span class="m-send">Enviar</span>
								</div>
							</div>

							<!-- Panel de contacto -->
							<aside class="m-contact">
								<div class="m-ct-title">Info del contacto</div>
								<div class="m-ct-card">
									<div class="m-av m-av-lg" style="background:linear-gradient(135deg,#17cbda,#245ef5)">MF</div>
									<div class="m-ct-name">María Fernández</div>
									<div class="m-ct-phone">+51 987 654 321</div>
								</div>
								<div class="m-block" data-crm-target="4">
									<div class="m-block-h">Etiquetas</div>
									<div class="m-tags">
										<span><i style="background:#f59e0b"></i>Lead caliente</span>
										<span><i style="background:#17cbda"></i>Restaurante</span>
										<span><i style="background:#a78bfa"></i>Lima</span>
										<span class="m-add">+ Agregar</span>
									</div>
								</div>
								<div class="m-block" data-crm-target="5">
									<div class="m-block-h">Deals</div>
									<div class="m-deal">
										<div class="m-deal-t">Plan Negocio · 3 sucursales</div>
										<div class="m-deal-v">S/ 447 <small>/ mes</small></div>
										<div class="m-deal-stage"><i></i>Ventas · Propuesta enviada</div>
										<div class="m-deal-bar"><span></span></div>
									</div>
								</div>
								<div class="m-block">
									<div class="m-block-h">Notas</div>
									<div class="m-note">Pidió una demo para el jueves.</div>
								</div>
								<div class="m-block">
									<div class="m-block-h">Tareas</div>
									<div class="m-task"><span class="material-symbols-outlined">event</span>Llamar jue 10:00</div>
								</div>
							</aside>
						</div>
					</div>
				</div>

				<!-- Tarjetas de vidrio -->
				{features.map((f) => (
					<article class:list={['crm-card', f.pos]} data-card={f.n}>
						<div class="crm-card-head">
							<span class="crm-card-num">{String(f.n).padStart(2, '0')}</span>
							<span class="crm-card-ico material-symbols-outlined" aria-hidden="true">{f.icon}</span>
						</div>
						<h3 class="crm-type crm-card-title">
							<span class="sr-only">{f.title}</span>
							<span class="crm-ghost" aria-hidden="true">{f.title}</span>
							<span class="crm-typed" aria-hidden="true" data-text={f.title}>{f.title}</span>
						</h3>
						<p class="crm-type crm-card-desc">
							<span class="sr-only">{f.desc}</span>
							<span class="crm-ghost" aria-hidden="true">{f.desc}</span>
							<span class="crm-typed" aria-hidden="true" data-text={f.desc}>{f.desc}</span>
						</p>
					</article>
				))}
			</div>

			<!-- Líneas de señalización -->
			<svg class="crm-lines" id="crm-lines" aria-hidden="true">
				<defs>
					<filter id="crm-line-glow" x="-20%" y="-20%" width="140%" height="140%">
						<feGaussianBlur stdDeviation="2" result="b"></feGaussianBlur>
						<feMerge><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
					</filter>
				</defs>
				{features.map((f) => (
					<g data-line={f.n}>
						<path class="crm-line" d=""></path>
						<circle class="crm-line-end" r="3" cx="-10" cy="-10"></circle>
					</g>
				))}
			</svg>

			<!-- Puntos sobre la interfaz -->
			<div class="crm-dots" aria-hidden="true">
				{features.map((f) => (
					<span class="crm-dot" data-dot={f.n}><span class="crm-dot-ring"></span><span class="crm-dot-core">{f.n}</span></span>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	/* ---------- Escenario y grilla ---------- */
	.crm-stage {
		position: relative;
	}
	.crm-grid {
		display: grid;
		gap: 16px;
		grid-template-columns: 1fr;
		grid-template-areas: 'm';
	}
	.crm-mock-wrap {
		grid-area: m;
		position: relative;
		width: 100%;
		z-index: 1;
	}
	@media (min-width: 640px) {
		.crm-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			grid-template-areas:
				't1 t2 t3'
				'm m m'
				'b1 b2 b3';
			row-gap: 56px;
			column-gap: 16px;
		}
		.p-t1 { grid-area: t1; }
		.p-t2 { grid-area: t2; }
		.p-t3 { grid-area: t3; }
		.p-b1 { grid-area: b1; }
		.p-b2 { grid-area: b2; }
		.p-b3 { grid-area: b3; }
	}
	@media (min-width: 1024px) {
		.crm-grid {
			grid-template-columns: minmax(190px, 232px) minmax(0, 1fr) minmax(190px, 232px);
			grid-template-rows: repeat(3, auto);
			grid-template-areas:
				'l1 m r1'
				'l2 m r2'
				'l3 m r3';
			column-gap: 48px;
			row-gap: 16px;
			align-items: center;
		}
		.crm-mock-wrap { align-self: center; }
		.p-l1 { grid-area: l1; }
		.p-l2 { grid-area: l2; }
		.p-l3 { grid-area: l3; }
		.p-r1 { grid-area: r1; }
		.p-r2 { grid-area: r2; }
		.p-r3 { grid-area: r3; }
	}

	/* ---------- Tarjetas de vidrio ---------- */
	.crm-card {
		position: relative;
		z-index: 3;
		padding: 16px 18px 18px;
		border-radius: 16px;
		background: linear-gradient(160deg, rgba(14, 22, 44, 0.62), rgba(6, 10, 26, 0.48));
		backdrop-filter: blur(14px) saturate(140%);
		-webkit-backdrop-filter: blur(14px) saturate(140%);
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.03) inset,
			0 10px 40px -12px rgba(36, 94, 245, 0.35),
			0 0 28px -8px rgba(23, 203, 218, 0.25);
	}
	.crm-card::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		padding: 1px;
		background: linear-gradient(135deg, rgba(23, 203, 218, 0.85), rgba(36, 94, 245, 0.25) 45%, rgba(255, 255, 255, 0.08) 70%, rgba(36, 94, 245, 0.7));
		-webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		pointer-events: none;
	}
	.crm-card-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 10px;
	}
	.crm-card-num {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.18em;
		color: #5fe3ee;
		font-variant-numeric: tabular-nums;
	}
	.crm-card-ico {
		font-size: 18px;
		width: 30px;
		height: 30px;
		display: grid;
		place-items: center;
		border-radius: 9px;
		color: #fff;
		background: linear-gradient(135deg, rgba(23, 203, 218, 0.35), rgba(36, 94, 245, 0.35));
		box-shadow: 0 0 0 1px rgba(95, 227, 238, 0.35) inset, 0 0 16px rgba(23, 203, 218, 0.3);
	}
	.crm-card-title {
		font-size: 16px;
		font-weight: 700;
		line-height: 1.25;
		color: #fff;
		margin-bottom: 6px;
	}
	.crm-card-desc {
		font-size: 13px;
		line-height: 1.5;
		color: rgba(203, 213, 225, 0.82);
	}
	.crm-type {
		position: relative;
	}
	.crm-ghost {
		visibility: hidden;
	}
	.crm-typed {
		position: absolute;
		inset: 0;
	}
	.crm-typed.is-typing::after {
		content: '';
		display: inline-block;
		width: 2px;
		height: 1.05em;
		margin-left: 2px;
		vertical-align: -0.15em;
		background: #5fe3ee;
		box-shadow: 0 0 8px #17cbda;
		animation: crm-caret 0.7s steps(1) infinite;
	}
	@keyframes crm-caret {
		50% { opacity: 0; }
	}

	/* ---------- Líneas y puntos ---------- */
	.crm-lines {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
		z-index: 2;
	}
	.crm-line {
		fill: none;
		stroke: #3fd6e6;
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
		filter: url(#crm-line-glow);
		opacity: 0.9;
	}
	.crm-line-end {
		fill: #5fe3ee;
		filter: url(#crm-line-glow);
	}
	.crm-dots {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 4;
	}
	.crm-dot {
		position: absolute;
		left: 0;
		top: 0;
		width: 18px;
		height: 18px;
		margin: -9px 0 0 -9px;
	}
	.crm-dot-core {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		border-radius: 999px;
		font-size: 10px;
		font-weight: 800;
		color: #031018;
		background: linear-gradient(135deg, #5fe3ee, #17cbda 45%, #245ef5);
		box-shadow: 0 0 0 2px rgba(3, 0, 20, 0.65), 0 0 14px rgba(23, 203, 218, 0.9);
	}
	.crm-dot-ring {
		position: absolute;
		inset: -7px;
		border-radius: 999px;
		border: 1.5px solid rgba(95, 227, 238, 0.85);
		opacity: 0;
	}
	.crm-dot.is-live .crm-dot-ring {
		animation: crm-pulse 1.6s ease-out infinite;
	}
	@keyframes crm-pulse {
		0% { transform: scale(0.5); opacity: 0.9; }
		100% { transform: scale(1.9); opacity: 0; }
	}
	@media (max-width: 639px) {
		.crm-lines { display: none; }
	}

	/* ---------- Mockup WACRM (diseñado a 1000 × 640 y escalado) ---------- */
	.crm-mock {
		--bg: #0b0d12;
		--card: #14161c;
		--card2: #191b22;
		--muted: #1e2028;
		--border: #292c35;
		--fg: #f4f5f7;
		--mfg: #949aa6;
		--p: #17cbda;
		--p2: #245ef5;
		width: 1000px;
		height: 640px;
		transform-origin: 0 0;
		border-radius: 14px;
		overflow: hidden;
		background: var(--bg);
		color: var(--fg);
		font-family: Inter, system-ui, sans-serif;
		font-size: 12px;
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.08),
			0 30px 80px -20px rgba(36, 94, 245, 0.45),
			0 0 60px -10px rgba(23, 203, 218, 0.25);
		position: absolute;
		left: 0;
		top: 0;
	}
	.crm-mock .material-symbols-outlined {
		font-size: 15px;
		font-variation-settings: 'wght' 300;
		line-height: 1;
	}
	.m-chrome {
		height: 34px;
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 0 14px;
		background: #101218;
		border-bottom: 1px solid var(--border);
	}
	.m-dots { display: flex; gap: 6px; }
	.m-dots span { width: 10px; height: 10px; border-radius: 50%; background: #2c2f38; }
	.m-dots span:first-child { background: #ff5f57; }
	.m-dots span:nth-child(2) { background: #febc2e; }
	.m-dots span:nth-child(3) { background: #28c840; }
	.m-url {
		flex: 1;
		max-width: 420px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		height: 22px;
		border-radius: 6px;
		background: #181a21;
		color: var(--mfg);
		font-size: 11px;
	}
	.m-url .material-symbols-outlined { font-size: 12px; }
	.m-app {
		display: grid;
		grid-template-columns: 170px 262px 1fr 214px;
		height: calc(100% - 34px);
	}
	/* Sidebar */
	.m-side {
		display: flex;
		flex-direction: column;
		background: var(--card);
		border-right: 1px solid var(--border);
		padding-bottom: 8px;
	}
	.m-brand {
		height: 46px;
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 0 12px;
		border-bottom: 1px solid var(--border);
		font-weight: 600;
		font-size: 12.5px;
	}
	.m-logo {
		width: 26px;
