---
// Nosotros: declaración que se "enciende" palabra por palabra al hacer scroll + tarjetas de valores.
const statement = 'En SCAL-IA combinamos experiencia técnica avanzada con una visión estratégica para crear soluciones tecnológicas que transforman negocios y procesos.';
const strong = new Set(['SCAL-IA', 'experiencia', 'técnica', 'avanzada', 'visión', 'estratégica', 'transforman']);
const values = [
	{ n: '01', icon: 'all_inclusive', title: 'Innovación Constante', desc: 'Nos mantenemos a la vanguardia de las tecnologías emergentes para ofrecerte soluciones verdaderamente innovadoras.' },
	{ n: '02', icon: 'settings_suggest', title: 'Enfoque Personalizado', desc: 'Cada proyecto comienza con un diagnóstico exhaustivo para diseñar soluciones que se adaptan perfectamente a tus necesidades.' },
	{ n: '03', icon: 'monitoring', title: 'Resultados Medibles', desc: 'Nuestras soluciones están diseñadas para generar impacto real y medible en tu negocio, con métricas claras de éxito.' },
];
---

<section id="about" class="ab w-full py-24 md:py-28 px-4 relative overflow-x-clip" translate="no">
	<div class="max-w-6xl mx-auto relative z-10">
		<div class="sc-head">
			<div class="sc-eyebrow">Sobre nosotros</div>
			<h2 class="sc-h2">Expertos en <span class="text-gradient">Inteligencia Artificial</span> y desarrollo tecnológico</h2>
		</div>

		<div class="ab-statement sc-glass" data-ab-statement>
			<span class="ab-quote material-symbols-outlined" aria-hidden="true">format_quote</span>
			<p>
				{statement.split(' ').map((w) => (
					<span class:list={['ab-w', { 'ab-strong': strong.has(w.replace(/[.,]/g, '')) }]}>{w} </span>
				))}
			</p>
		</div>

		<div class="ab-values">
			{values.map((v) => (
				<article class="ab-card sc-glass sc-spot" data-ab-card>
					<div class="ab-card-top">
						<span class="ab-icon material-symbols-outlined" aria-hidden="true">{v.icon}</span>
						<span class="ab-n">{v.n}</span>
					</div>
					<h3 class="ab-title">{v.title}</h3>
					<p class="ab-desc">{v.desc}</p>
					<span class="ab-bar" aria-hidden="true"></span>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.ab-statement { max-width: 56rem; margin: 0 auto 3.5rem; padding: 2.4rem 2.6rem 2.4rem 4.6rem; border-radius: 22px; }
	.ab-quote { position: absolute; left: 1.4rem; top: 1.6rem; font-size: 2.4rem !important; color: var(--color-neon-400); opacity: 0.8; }
	.ab-statement p { font-size: clamp(1.15rem, 0.95rem + 0.9vw, 1.6rem); line-height: 1.5; font-weight: 500; letter-spacing: -0.01em; color: #e2e8f0; }
	.ab-strong { color: #fff; font-weight: 700; }
	.ab-values { display: grid; gap: 1.25rem; }
	@media (min-width: 768px) { .ab-values { grid-template-columns: repeat(3, 1fr); } }
	.ab-card { padding: 1.6rem 1.5rem 1.8rem; border-radius: 20px; transition: transform 0.35s ease; }
	.ab-card:hover { transform: translateY(-4px); }
	.ab-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.4rem; }
	.ab-icon { width: 3rem; height: 3rem; display: grid; place-items: center; border-radius: 14px; font-size: 1.5rem !important; color: #fff; background: linear-gradient(135deg, rgba(23, 203, 218, 0.35), rgba(36, 94, 245, 0.35)); box-shadow: 0 0 0 1px rgba(95, 232, 255, 0.3) inset, 0 0 22px rgba(var(--scalia-glow-cyan), 0.3); }
	.ab-n { font-size: 2.1rem; font-weight: 800; letter-spacing: -0.04em; color: transparent; -webkit-text-stroke: 1px rgba(159, 243, 251, 0.35); }
	.ab-title { font-size: 1.2rem; font-weight: 700; color: #fff; margin-bottom: 0.55rem; }
	.ab-desc { font-size: 0.95rem; line-height: 1.6; color: rgba(203, 213, 225, 0.85); }
	.ab-bar { position: absolute; left: 1.5rem; right: 1.5rem; bottom: 0; height: 2px; border-radius: 2px; background: var(--scalia-gradient); transform-origin: 0 50%; opacity: 0.7; }
	@media (max-width: 639px) {
		.ab-statement { padding: 3.6rem 1.4rem 1.6rem; }
		.ab-quote { top: 1.1rem; left: 1.2rem; }
	}
	@media (prefers-reduced-motion: reduce) { .ab-card, .ab-card:hover { transition: none; transform: none; } }
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { prefersReducedMotion } from '../scripts/fit-mock';
	import { initSpotlight } from '../scripts/spotlight';

	gsap.registerPlugin(ScrollTrigger);
	const root = document.getElementById('about');
	if (root) {
		initSpotlight(root);
		if (!prefersReducedMotion()) {
			const words = root.querySelectorAll('.ab-w');
			// La frase se ilumina palabra por palabra, ligada al scroll.
			gsap.fromTo(words, { opacity: 0.18 }, { opacity: 1, stagger: 0.08, ease: 'none', scrollTrigger: { trigger: '[data-ab-statement]', start: 'top 80%', end: 'bottom 45%', scrub: true } });
			gsap.from('[data-ab-statement]', { y: 40, autoAlpha: 0, duration: 0.9, ease: 'power3.out', scrollTrigger: { trigger: '[data-ab-statement]', start: 'top 88%', once: true } });
			// Tarjetas: se despliegan en 3D, una tras otra, y su barra inferior se dibuja.
			const cards = root.querySelectorAll('[data-ab-card]');
			const tl = gsap.timeline({ scrollTrigger: { trigger: root.querySelector('.ab-values'), start: 'top 80%', once: true } });
			tl.from(cards, { autoAlpha: 0, y: 50, rotateX: 18, transformPerspective: 900, transformOrigin: '50% 100%', duration: 0.8, stagger: 0.14, ease: 'power3.out' })
				.from(root.querySelectorAll('.ab-bar'), { scaleX: 0, duration: 0.7, stagger: 0.14, ease: 'power2.inOut' }, '-=0.6')
				.from(root.querySelectorAll('.ab-icon'), { scale: 0.4, rotate: -30, duration: 0.5, stagger: 0.14, ease: 'back.out(2.4)' }, 0.15);
		}
	}
</script>
