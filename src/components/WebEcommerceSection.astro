---
// Sección "Diseño web y ecommerce": navegador que alterna capturas de sitios de demostración + celular con su versión móvil.
const features = [
	{ icon: 'language', title: 'Sitios web corporativos', desc: 'Rápidos, adaptados a celulares y optimizados para aparecer en Google.' },
	{ icon: 'storefront', title: 'Tiendas online completas', desc: 'Catálogo, carrito, stock y pedidos que tu equipo administra sin depender de nadie.' },
	{ icon: 'payments', title: 'Pagos y envíos para Perú', desc: 'Pasarelas con tarjeta, Yape y Plin, con opciones de envío o recojo en tienda.' },
	{ icon: 'hub', title: 'Conectada a tu negocio', desc: 'Integración con WhatsApp, tu CRM y tu ERP para no duplicar trabajo.' },
	{ icon: 'query_stats', title: 'Medición y crecimiento', desc: 'Analítica y SEO para convertir visitas en clientes.' },
];
// Capturas de sitios de demostración (negocios ficticios) creados por Scalia. Fotos: Wikimedia Commons, dominio público / CC0.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sites = [
	{ id: 'tienda', url: 'lumara.demo', label: 'Tienda de moda',
		alt: 'Página de inicio de Lumara, tienda de moda online de demostración: colección de temporada, precios en soles, pagos con Yape, Plin o tarjeta y envíos a todo el Perú.',
		altM: 'Versión para celular de la tienda online de demostración Lumara.' },
	{ id: 'cevicheria', url: 'olamorena.demo', label: 'Cevichería',
		alt: 'Página de Ola Morena, cevichería de demostración en Chorrillos: carta con ceviche, arroz con mariscos y chicharrón, y reservas o pedidos por WhatsApp.',
		altM: 'Versión para celular de la cevichería de demostración Ola Morena con formulario de reserva por WhatsApp.' },
	{ id: 'inmobiliaria', url: 'nidora.demo', label: 'Inmobiliaria',
		alt: 'Página de Nidora, inmobiliaria de demostración en Lima: buscador por distrito, tipo, dormitorios y precio en soles o dólares, departamentos destacados con m², dormitorios y baños, y botón Agenda tu visita.',
		altM: 'Versión para celular de la inmobiliaria de demostración Nidora con el buscador de inmuebles.' },
	{ id: 'nikkei', url: 'hanagi.demo', label: 'Restaurante',
		alt: 'Página de Hanagi, restaurante de cocina nikkei de demostración en Barranco: diseño oscuro y elegante, menú degustación y reserva online con fecha, hora y personas.',
		altM: 'Versión para celular del restaurante nikkei de demostración Hanagi con el formulario de reserva online.' },
	{ id: 'clinica', url: 'clinicanuvia.demo', label: 'Clínica',
		alt: 'Página de Clínica Nuvia, centro médico de demostración: reserva de citas online con especialidad, sede, fecha y horarios disponibles.',
		altM: 'Versión para celular de Clínica Nuvia con el formulario para agendar una cita médica.' },
];
// Tamaño real de cada captura (página completa, no solo la primera pantalla) para el recorrido vertical.
const dims: Record<string, { d: number; m: number }> = {
	tienda: { d: 1211, m: 1910 }, cevicheria: { d: 1028, m: 2645 }, inmobiliaria: { d: 970, m: 1974 },
	nikkei: { d: 1448, m: 2756 }, clinica: { d: 836, m: 1748 },
};
---

<section class="we-section w-full py-24 px-4 relative overflow-x-clip" id="web-ecommerce" translate="no">
	<div class="max-w-7xl mx-auto relative z-10">
		<div class="text-center mb-14">
			<div class="sc-eyebrow mb-4">Diseño web y ecommerce</div>
			<h2 class="text-3xl md:text-5xl font-bold mb-6">
				Tu negocio, <span class="text-gradient">abierto las 24 horas</span>
			</h2>
			<p class="text-gray-400 text-lg max-w-2xl mx-auto">
				Páginas web y tiendas online que se ven bien en cualquier pantalla y venden mientras tú atiendes tu negocio.
			</p>
		</div>

		<div class="we-grid">
			<ul class="we-features">
				{features.map((f) => (
					<li class="we-feature" data-we-feature>
						<span class="sc-icon-chip material-symbols-outlined" aria-hidden="true">{f.icon}</span>
						<div>
							<h3 class="sc-feature-title">{f.title}</h3>
							<p class="sc-feature-desc">{f.desc}</p>
						</div>
					</li>
				))}
			</ul>

			<div class="we-stage">
			<div class="we-mock-wrap" data-we-wrap>
				<span class="sc-demo-chip" style="top:-12px;left:16px">Ejemplo</span>
				<div class="we-mock" data-we-mock>
					<!-- Navegador: crossfade entre sitios de demostración -->
					<div class="we-browser" data-we-browser>
						<div class="we-chrome" aria-hidden="true">
							<div class="we-dots"><span></span><span></span><span></span></div>
							<div class="we-url"><span class="material-symbols-outlined">lock</span><span data-we-url>{sites[0].url}</span></div>
						</div>
						<div class="we-view">
							{sites.map((site, i) => (
								<img class:list={['we-slide', { 'is-on': i === 0 }]} data-we-slide data-url={site.url} src={`${base}/portfolio/${site.id}-desktop.webp`} width="1280" height={dims[site.id]?.d ?? 800} loading="lazy" decoding="async" alt={site.alt} />
							))}
						</div>
					</div>

					<!-- Celular: versión móvil del mismo sitio -->
					<div class="we-phone" data-we-phone>
						<div class="we-notch" aria-hidden="true"></div>
						<div class="we-screen">
							{sites.map((site, i) => (
								<img class:list={['we-slide', { 'is-on': i === 0 }]} data-we-mslide src={`${base}/portfolio/${site.id}-mobile.webp`} width="440" height={dims[site.id]?.m ?? 952} loading="lazy" decoding="async" alt={site.altM} />
							))}
						</div>
					</div>

				</div>
			</div>
				<!-- Indicador de sitio -->
				<div class="we-tabs" role="group" aria-label="Sitios de ejemplo">
					{sites.map((site, i) => (
						<button type="button" class:list={['we-tab sc-focus', { 'is-on': i === 0 }]} data-we-tab aria-pressed={i === 0 ? 'true' : 'false'}><i></i><b>{site.label}</b><s aria-hidden="true"></s></button>
					))}
				</div>
			</div>
		</div>
		<p class="we-note">Capturas de 5 sitios de demostración para negocios ficticios. Fotos libres de dominio público y CC0.</p>
	</div>
</section>

<style>
	.we-grid { display: grid; gap: 28px; }
	.we-stage { min-width: 0; order: -1; }
	.we-mock-wrap { position: relative; width: 100%; }
	@media (min-width: 1024px) {
		.we-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.55fr); gap: 44px; align-items: center; }
		.we-stage { order: 0; }
	}
	.we-features { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
	@media (min-width: 640px) and (max-width: 1023px) { .we-features { grid-template-columns: 1fr 1fr; column-gap: 20px; } }
	.we-feature { display: flex; gap: 14px; padding: 12px 6px; border-bottom: 1px solid rgba(95, 232, 255, 0.1); }

	/* ---- Mockup (1000 × 600) ---- */
	.we-mock { position: absolute; left: 0; top: 0; width: 1000px; height: 566px; transform-origin: 0 0; font: 500 11px/1.35 Inter, system-ui, sans-serif; color: #e8eef7; }
	.we-mock .material-symbols-outlined { font-size: 14px; font-variation-settings: 'wght' 300; line-height: 1; }
	.we-browser { position: absolute; left: 0; top: 14px; width: 790px; height: 528px; border-radius: 14px; overflow: hidden; background: #0a1428; box-shadow: 0 0 0 1px rgba(255,255,255,.08), 0 30px 80px -20px rgba(36,94,245,.45), 0 0 60px -10px rgba(23,203,218,.2); }
	.we-chrome { height: 34px; display: flex; align-items: center; gap: 14px; padding: 0 14px; background: #0e1628; border-bottom: 1px solid #1d2a44; }
	.we-dots { display: flex; gap: 6px; } .we-dots span { width: 10px; height: 10px; border-radius: 50%; background: #2a3550; }
	.we-dots span:first-child { background: #ff5f57; } .we-dots span:nth-child(2) { background: #febc2e; } .we-dots span:nth-child(3) { background: #28c840; }
	.we-url { flex: 1; max-width: 340px; margin: 0 auto; height: 22px; display: flex; align-items: center; justify-content: center; gap: 6px; border-radius: 6px; background: #16213a; color: #9fb0cc; }
	.we-view { position: relative; height: 494px; background: #fff; overflow: hidden; }
	.we-slide { position: absolute; left: 0; top: 0; width: 100%; height: auto; min-height: 100%; opacity: 0; will-change: transform, opacity; }
	.we-slide.is-on { opacity: 1; }
	/* Celular */
	.we-phone { position: absolute; left: 772px; top: 96px; width: 226px; height: 466px; border-radius: 36px; padding: 10px; background: #0b1120; box-shadow: 0 0 0 1.5px #2a3a5c, 0 0 0 6px #070b16, 0 40px 80px -20px rgba(0,0,0,.85), 0 0 50px -10px rgba(23,203,218,.35); }
	.we-notch { position: absolute; left: 50%; top: 16px; width: 64px; height: 16px; margin-left: -32px; border-radius: 99px; background: #000; z-index: 3; }
	.we-screen { position: relative; height: 100%; border-radius: 27px; overflow: hidden; background: #fff; }
	/* Indicador */
	.we-tabs { margin-top: 14px; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
	@media (min-width: 1024px) { .we-tabs { margin-right: 21%; } }
	.we-tab b { font-weight: 500; }
	@media (max-width: 639px) { .we-tab:not(.is-on) { padding: 6px 7px; gap: 0; } .we-tab:not(.is-on) b { display: none; } }
	.we-tab { display: inline-flex; align-items: center; gap: 7px; padding: 6px 13px; border-radius: 99px; font: 500 12px/1.2 Inter, system-ui, sans-serif; color: #8ea0bd; background: rgba(10,20,40,.6); border: 1px solid rgba(95,232,255,.12); transition: color .4s, border-color .4s, background .4s; }
	.we-tab i { width: 7px; height: 7px; border-radius: 99px; background: #2a3a5c; transition: background .4s, box-shadow .4s; }
	.we-tab { position: relative; overflow: hidden; cursor: pointer; }
	.we-tab:hover { color: #dffbff; }
	.we-tab s { position: absolute; left: 10px; right: 10px; bottom: 2px; height: 2px; border-radius: 2px; background: linear-gradient(90deg, #5fe8ff, #2f7bff); transform: scaleX(0); transform-origin: 0 50%; opacity: 0; }
	.we-tab.is-on s { opacity: 1; }
	.we-tab.is-on { color: #dffbff; border-color: rgba(95,232,255,.45); background: rgba(23,203,218,.1); }
	.we-tab.is-on i { background: #5fe8ff; box-shadow: 0 0 8px #5fe8ff; }
	.we-note { margin-top: 18px; text-align: center; font-size: 12.5px; color: #8392ab; }
	@media (min-width: 1024px) { .we-note { text-align: right; } }
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { fitMock, prefersReducedMotion } from '../scripts/fit-mock';
	import { revealCards } from '../scripts/reveal';

	gsap.registerPlugin(ScrollTrigger);
	const root = document.getElementById('web-ecommerce');
	const wrap = root?.querySelector<HTMLElement>('[data-we-wrap]');
	const mock = root?.querySelector<HTMLElement>('[data-we-mock]');
	if (root && wrap && mock) {
		fitMock(wrap, mock, 1000, 566);
		revealCards(root.querySelectorAll<HTMLElement>('[data-we-feature]'));
		const reduce = prefersReducedMotion();
		const q = (sel: string) => Array.from(root.querySelectorAll<HTMLElement>(sel));
		const slides = q('[data-we-slide]') as HTMLImageElement[];
		const mslides = q('[data-we-mslide]') as HTMLImageElement[];
		const tabs = q('[data-we-tab]');
		const bars = tabs.map((t) => t.querySelector('s') as HTMLElement);
		const view = root.querySelector<HTMLElement>('.we-view')!;
		const screen = root.querySelector<HTMLElement>('.we-screen')!;
		const urlEl = root.querySelector<HTMLElement>('[data-we-url]');
		const urls = slides.map((sl) => sl.dataset.url ?? '');
		const HOLD = 4.6; // segundos por sitio
		const FADE = reduce ? 0.8 : 0.9;

		// Las imágenes "lazy" de las demás demos se cargan al acercarse a la sección.
		const eager = () => [...slides, ...mslides].forEach((img) => (img.loading = 'eager'));
		// Distancia de recorrido vertical: alto de la captura menos el alto visible (en px del mockup).
		const range = (img: HTMLImageElement, box: HTMLElement) => {
			const h = img.naturalWidth ? (img.naturalHeight / img.naturalWidth) * box.clientWidth : Number(img.getAttribute('height')) / Number(img.getAttribute('width')) * box.clientWidth;
			return Math.max(0, h - box.clientHeight);
		};

		let idx = 0;
		let cycle: gsap.core.Timeline | null = null;
		let visible = false;
		let hover = false;
		let started = false;

		const setActive = (i: number) => tabs.forEach((t, k) => { t.classList.toggle('is-on', k === i); t.setAttribute('aria-pressed', String(k === i)); });

		function play(i: number) {
			cycle?.kill();
			gsap.set(bars, { scaleX: 0 });
			const img = slides[i];
			const mimg = mslides[i];
			cycle = gsap.timeline({ onComplete: () => show((idx + 1) % slides.length) });
			cycle.to(bars[i], { scaleX: 1, duration: HOLD, ease: 'none' }, 0);
			if (!reduce) {
				// Recorrido suave por la página: baja y vuelve arriba justo antes del cambio.
				const dr = range(img, view);
				const mr = range(mimg, screen);
				cycle.fromTo(img, { y: 0 }, { y: -dr, duration: HOLD * 0.62, ease: 'sine.inOut' }, 0.5)
					.to(img, { y: 0, duration: HOLD * 0.25, ease: 'sine.inOut' }, HOLD * 0.72)
					.fromTo(mimg, { y: 0 }, { y: -mr, duration: HOLD * 0.62, ease: 'sine.inOut' }, 0.7)
					.to(mimg, { y: 0, duration: HOLD * 0.22, ease: 'sine.inOut' }, HOLD * 0.75);
			}
			sync();
		}

		function show(next: number) {
			const prev = idx;
			idx = next;
			setActive(next);
			if (next !== prev) {
				gsap.to([slides[prev], mslides[prev]], { opacity: 0, duration: FADE, ease: 'power1.inOut', overwrite: 'auto' });
				if (reduce) {
					gsap.to([slides[next], mslides[next]], { opacity: 1, duration: FADE, ease: 'power1.inOut', overwrite: 'auto' });
				} else {
					gsap.fromTo(slides[next], { opacity: 0, scale: 1.03, y: 0 }, { opacity: 1, scale: 1, duration: FADE, ease: 'power2.inOut', overwrite: 'auto' });
					gsap.fromTo(mslides[next], { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: FADE, delay: 0.1, ease: 'power2.inOut', overwrite: 'auto' });
				}
				if (urlEl) gsap.to(urlEl, { opacity: 0, duration: 0.2, onComplete: () => { urlEl.textContent = urls[next]; gsap.to(urlEl, { opacity: 1, duration: 0.25 }); } });
			}
			play(next);
		}

		// Pausa con el cursor encima, con foco dentro, fuera de pantalla o con la pestaña oculta.
		function sync() {
			if (!cycle) return;
			const run = started && visible && !hover && !document.hidden;
			run ? cycle.resume() : cycle.pause();
		}

		gsap.set(slides, { opacity: 0 }); gsap.set(mslides, { opacity: 0 });
		gsap.set([slides[0], mslides[0]], { opacity: 1 });
		const stage = root.querySelector<HTMLElement>('.we-stage')!;
		// Solo con mouse (en táctil no hay "salir" del hover) y con foco de teclado, no con clic.
		stage.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { hover = true; sync(); } });
		stage.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') { hover = false; sync(); } });
		stage.addEventListener('focusin', (e) => { if ((e.target as HTMLElement).matches(':focus-visible')) { hover = true; sync(); } });
		stage.addEventListener('focusout', () => { hover = false; sync(); });
		document.addEventListener('visibilitychange', sync);
		tabs.forEach((t, i) => t.addEventListener('click', () => { started = true; if (i !== idx) show(i); else play(i); }));
		new IntersectionObserver((e) => { visible = e[0].isIntersecting; if (visible) eager(); sync(); }, { threshold: 0.25 }).observe(wrap);
		ScrollTrigger.create({ trigger: wrap, start: 'top 140%', once: true, onEnter: eager });

		const begin = () => { started = true; play(idx); };
		if (reduce) {
			// Movimiento reducido: entrada con fundido y luego solo fundidos entre sitios.
			gsap.timeline({ scrollTrigger: { trigger: wrap, start: 'top 80%', once: true }, onComplete: begin })
				.from('[data-we-browser]', { autoAlpha: 0, duration: 0.6 })
				.from('[data-we-phone]', { autoAlpha: 0, duration: 0.6 }, '-=0.3')
				.from('.we-tab', { autoAlpha: 0, duration: 0.3, stagger: 0.06 }, '-=0.3');
		} else {
			gsap.timeline({ scrollTrigger: { trigger: wrap, start: 'top 75%', once: true }, onComplete: begin })
				.from('[data-we-browser]', { autoAlpha: 0, x: -70, rotateY: 8, transformPerspective: 1200, duration: 0.8, ease: 'power3.out' })
				.from(slides[0], { scale: 1.06, duration: 1.1, ease: 'power2.out' }, '-=0.5')
				.from('[data-we-phone]', { autoAlpha: 0, y: 110, x: 40, rotate: 7, duration: 0.85, ease: 'power3.out' }, '-=0.8')
				.from('.we-tab', { autoAlpha: 0, y: 10, duration: 0.4, stagger: 0.08, ease: 'power2.out' }, '-=0.4');
		}
	}
</script>
