---
// Sección "Diseño web y ecommerce": navegador que alterna capturas de sitios de demostración + celular con su versión móvil.
const features = [
	{ icon: 'language', title: 'Sitios web corporativos', desc: 'Rápidos, adaptados a celulares y optimizados para aparecer en Google.' },
	{ icon: 'storefront', title: 'Tiendas online completas', desc: 'Catálogo, carrito, stock y pedidos que tu equipo administra sin depender de nadie.' },
	{ icon: 'payments', title: 'Pagos y envíos para Perú', desc: 'Pasarelas con tarjeta, Yape y Plin, con opciones de envío o recojo en tienda.' },
	{ icon: 'hub', title: 'Conectada a tu negocio', desc: 'Integración con WhatsApp, tu CRM y tu ERP para no duplicar trabajo.' },
	{ icon: 'query_stats', title: 'Medición y crecimiento', desc: 'Analítica y SEO para convertir visitas en clientes.' },
];
// Capturas de sitios de demostración (negocios ficticios) creados por Scalia. Fotos: Wikimedia Commons, dominio público / CC0.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sites = [
	{ id: 'tienda', url: 'lumara.demo', label: 'Tienda de moda',
		alt: 'Página de inicio de Lumara, tienda de moda online de demostración: colección de temporada, precios en soles, pagos con Yape, Plin o tarjeta y envíos a todo el Perú.',
		altM: 'Versión para celular de la tienda online de demostración Lumara.' },
	{ id: 'cevicheria', url: 'olamorena.demo', label: 'Cevichería',
		alt: 'Página de Ola Morena, cevichería de demostración en Chorrillos: carta con ceviche, arroz con mariscos y chicharrón, y reservas o pedidos por WhatsApp.',
		altM: 'Versión para celular de la cevichería de demostración Ola Morena con formulario de reserva por WhatsApp.' },
	{ id: 'clinica', url: 'clinicanuvia.demo', label: 'Clínica',
		alt: 'Página de Clínica Nuvia, centro médico de demostración: reserva de citas online con especialidad, sede, fecha y horarios disponibles.',
		altM: 'Versión para celular de Clínica Nuvia con el formulario para agendar una cita médica.' },
];
---

<section class="we-section w-full py-24 px-4 relative overflow-x-clip" id="web-ecommerce" translate="no">
	<div class="max-w-7xl mx-auto relative z-10">
		<div class="text-center mb-14">
			<div class="sc-eyebrow mb-4">Diseño web y ecommerce</div>
			<h2 class="text-3xl md:text-5xl font-bold mb-6">
				Tu negocio, <span class="text-gradient">abierto las 24 horas</span>
			</h2>
			<p class="text-gray-400 text-lg max-w-2xl mx-auto">
				Páginas web y tiendas online que se ven bien en cualquier pantalla y venden mientras tú atiendes tu negocio.
			</p>
		</div>

		<div class="we-grid">
			<ul class="we-features">
				{features.map((f) => (
					<li class="we-feature" data-we-feature>
						<span class="sc-icon-chip material-symbols-outlined" aria-hidden="true">{f.icon}</span>
						<div>
							<h3 class="sc-feature-title">{f.title}</h3>
							<p class="sc-feature-desc">{f.desc}</p>
						</div>
					</li>
				))}
			</ul>

			<div class="we-mock-wrap" data-we-wrap>
				<span class="sc-demo-chip" style="top:-12px;left:16px">Ejemplo</span>
				<div class="we-mock" data-we-mock>
					<!-- Navegador: crossfade entre sitios de demostración -->
					<div class="we-browser" data-we-browser>
						<div class="we-chrome" aria-hidden="true">
							<div class="we-dots"><span></span><span></span><span></span></div>
							<div class="we-url"><span class="material-symbols-outlined">lock</span><span data-we-url>{sites[0].url}</span></div>
						</div>
						<div class="we-view">
							{sites.map((site, i) => (
								<img class:list={['we-slide', { 'is-on': i === 0 }]} data-we-slide src={`${base}/portfolio/${site.id}-desktop.webp`} width="1280" height="800" loading="lazy" decoding="async" alt={site.alt} />
							))}
						</div>
					</div>

					<!-- Celular: versión móvil del mismo sitio -->
					<div class="we-phone" data-we-phone>
						<div class="we-notch" aria-hidden="true"></div>
						<div class="we-screen">
							{sites.map((site, i) => (
								<img class:list={['we-slide', { 'is-on': i === 0 }]} data-we-mslide src={`${base}/portfolio/${site.id}-mobile.webp`} width="440" height="952" loading="lazy" decoding="async" alt={site.altM} />
							))}
						</div>
					</div>

					<!-- Indicador de sitio -->
					<div class="we-tabs" aria-hidden="true">
						{sites.map((site, i) => (
							<span class:list={['we-tab', { 'is-on': i === 0 }]} data-we-tab><i></i>{site.label}</span>
						))}
					</div>
				</div>
			</div>
		</div>
		<p class="we-note">Capturas de sitios de demostración para negocios ficticios. Fotos libres de dominio público y CC0.</p>
	</div>
</section>

<style>
	.we-grid { display: grid; gap: 28px; }
	.we-mock-wrap { position: relative; width: 100%; order: -1; }
	@media (min-width: 1024px) {
		.we-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.55fr); gap: 44px; align-items: center; }
		.we-mock-wrap { order: 0; }
	}
	.we-features { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
	@media (min-width: 640px) and (max-width: 1023px) { .we-features { grid-template-columns: 1fr 1fr; column-gap: 20px; } }
	.we-feature { display: flex; gap: 14px; padding: 12px 6px; border-bottom: 1px solid rgba(95, 232, 255, 0.1); }

	/* ---- Mockup (1000 × 600) ---- */
	.we-mock { position: absolute; left: 0; top: 0; width: 1000px; height: 600px; transform-origin: 0 0; font: 500 11px/1.35 Inter, system-ui, sans-serif; color: #e8eef7; }
	.we-mock .material-symbols-outlined { font-size: 14px; font-variation-settings: 'wght' 300; line-height: 1; }
	.we-browser { position: absolute; left: 0; top: 14px; width: 790px; height: 528px; border-radius: 14px; overflow: hidden; background: #0a1428; box-shadow: 0 0 0 1px rgba(255,255,255,.08), 0 30px 80px -20px rgba(36,94,245,.45), 0 0 60px -10px rgba(23,203,218,.2); }
	.we-chrome { height: 34px; display: flex; align-items: center; gap: 14px; padding: 0 14px; background: #0e1628; border-bottom: 1px solid #1d2a44; }
	.we-dots { display: flex; gap: 6px; } .we-dots span { width: 10px; height: 10px; border-radius: 50%; background: #2a3550; }
	.we-dots span:first-child { background: #ff5f57; } .we-dots span:nth-child(2) { background: #febc2e; } .we-dots span:nth-child(3) { background: #28c840; }
	.we-url { flex: 1; max-width: 340px; margin: 0 auto; height: 22px; display: flex; align-items: center; justify-content: center; gap: 6px; border-radius: 6px; background: #16213a; color: #9fb0cc; }
	.we-view { position: relative; height: 494px; background: #fff; overflow: hidden; }
	.we-slide { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center; opacity: 0; }
	.we-slide.is-on { opacity: 1; }
	/* Celular */
	.we-phone { position: absolute; left: 772px; top: 96px; width: 226px; height: 466px; border-radius: 36px; padding: 10px; background: #0b1120; box-shadow: 0 0 0 1.5px #2a3a5c, 0 0 0 6px #070b16, 0 40px 80px -20px rgba(0,0,0,.85), 0 0 50px -10px rgba(23,203,218,.35); }
	.we-notch { position: absolute; left: 50%; top: 16px; width: 64px; height: 16px; margin-left: -32px; border-radius: 99px; background: #000; z-index: 3; }
	.we-screen { position: relative; height: 100%; border-radius: 27px; overflow: hidden; background: #fff; }
	/* Indicador */
	.we-tabs { position: absolute; left: 0; top: 556px; width: 790px; display: flex; justify-content: center; gap: 10px; }
	.we-tab { display: inline-flex; align-items: center; gap: 7px; padding: 6px 13px; border-radius: 99px; font-size: 12px; color: #8ea0bd; background: rgba(10,20,40,.6); border: 1px solid rgba(95,232,255,.12); transition: color .4s, border-color .4s, background .4s; }
	.we-tab i { width: 7px; height: 7px; border-radius: 99px; background: #2a3a5c; transition: background .4s, box-shadow .4s; }
	.we-tab.is-on { color: #dffbff; border-color: rgba(95,232,255,.45); background: rgba(23,203,218,.1); }
	.we-tab.is-on i { background: #5fe8ff; box-shadow: 0 0 8px #5fe8ff; }
	.we-note { margin-top: 18px; text-align: center; font-size: 12.5px; color: #8392ab; }
	@media (min-width: 1024px) { .we-note { text-align: right; } }
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { fitMock, prefersReducedMotion } from '../scripts/fit-mock';

	gsap.registerPlugin(ScrollTrigger);
	const root = document.getElementById('web-ecommerce');
	const wrap = root?.querySelector<HTMLElement>('[data-we-wrap]');
	const mock = root?.querySelector<HTMLElement>('[data-we-mock]');
	if (root && wrap && mock) {
		fitMock(wrap, mock, 1000, 600);
		const q = (sel: string) => Array.from(root.querySelectorAll<HTMLElement>(sel));
		const slides = q('[data-we-slide]');
		const mslides = q('[data-we-mslide]');
		const tabs = q('[data-we-tab]');
		const urlEl = root.querySelector<HTMLElement>('[data-we-url]');
		const urls = ['lumara.demo', 'olamorena.demo', 'clinicanuvia.demo'];
		if (!prefersReducedMotion()) {
			gsap.set(q('[data-we-feature]'), { autoAlpha: 0, x: -20 });
			let idx = 0;
			let timer: number | undefined;
			let visible = false;
			const show = (next: number) => {
				const prev = idx;
				if (next === prev) return;
				idx = next;
				gsap.to([slides[prev], mslides[prev]], { opacity: 0, duration: 0.9, ease: 'power2.inOut' });
				gsap.fromTo(slides[next], { opacity: 0, scale: 1.035 }, { opacity: 1, scale: 1, duration: 0.9, ease: 'power2.inOut' });
				gsap.fromTo(mslides[next], { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.9, delay: 0.12, ease: 'power2.inOut' });
				tabs.forEach((t, i) => t.classList.toggle('is-on', i === next));
				if (urlEl) gsap.to(urlEl, { opacity: 0, duration: 0.2, onComplete: () => { urlEl.textContent = urls[next]; gsap.to(urlEl, { opacity: 1, duration: 0.25 }); } });
			};
			const loop = () => {
				window.clearTimeout(timer);
				if (!visible || document.hidden) return;
				timer = window.setTimeout(() => { show((idx + 1) % slides.length); loop(); }, 3800);
			};
			const io = new IntersectionObserver((entries) => { visible = entries[0].isIntersecting; loop(); }, { threshold: 0.2 });
			document.addEventListener('visibilitychange', loop);
			const tl = gsap.timeline({ scrollTrigger: { trigger: wrap, start: 'top 75%', once: true }, onComplete: () => io.observe(wrap) });
			tl.from('[data-we-browser]', { autoAlpha: 0, x: -70, rotateY: 8, transformPerspective: 1200, duration: 0.8, ease: 'power3.out' })
				.from(slides[0], { scale: 1.06, duration: 1.1, ease: 'power2.out' }, '-=0.5')
				.from('[data-we-phone]', { autoAlpha: 0, y: 110, x: 40, rotate: 7, duration: 0.85, ease: 'power3.out' }, '-=0.8')
				.from('.we-tab', { autoAlpha: 0, y: 10, duration: 0.4, stagger: 0.08, ease: 'power2.out' }, '-=0.4')
				.to(q('[data-we-feature]'), { autoAlpha: 1, x: 0, duration: 0.5, stagger: 0.1, ease: 'power3.out' }, 0.2);
		}
	}
</script>
