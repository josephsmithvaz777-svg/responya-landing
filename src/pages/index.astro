---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import AboutSection from "../components/AboutSection.astro";
import ServicesSection from "../components/ServicesSection.astro";
import DisenoMedidaSection from "../components/DisenoMedidaSection.astro";
import WebEcommerceSection from "../components/WebEcommerceSection.astro";
import CRMSection from "../components/CRMSection.astro";
import ERPSection from "../components/ERPSection.astro";
import ProcessSection from "../components/ProcessSection.astro";
import IntegrationsSection from "../components/IntegrationsSection.astro";
import ContactSection from "../components/ContactSection.astro";
import Footer from "../components/Footer.astro";
import PrivacyModal from "../components/PrivacyModal.astro";
import TermsModal from "../components/TermsModal.astro";
import "../styles/global.css";
---

<Layout title="SCAL-IA - Soluciones de IA">
	<Header />

	<main class="flex-1 w-full flex flex-col items-center pt-20 relative z-10">
		<Hero />
		<AboutSection />
		<ServicesSection />

		<!-- Soluciones: diseño a medida, web y ecommerce, CRM y ERP -->
		<DisenoMedidaSection />
		<WebEcommerceSection />
		<CRMSection />
		<ERPSection />

		<ProcessSection />
		<IntegrationsSection />
		<ContactSection />
	</main>

	<Footer />

	<!-- Modals -->
	<PrivacyModal />
	<TermsModal />
</Layout>
